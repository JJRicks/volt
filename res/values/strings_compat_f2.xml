<?xml version="1.0" encoding="utf-8"?>
<!--
  Compatibility follow-up (batch F2): the Fields group's presence words in the Compatibility panel, and
  the review a guided test gives while it is still running. The English must stay exactly what the
  source said before the batch (G1, G2). The compatibility report keeps its own English words.
-->
<resources xmlns:volt="https://volt.jjricks.com/ns/l10n"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Fields group value: the scooter's status reply does not carry this field. -->
    <string name="compat_f2_field_absent" volt:screen="Compatibility results" volt:purpose="value">Absent</string>
    <!-- Fields group value: the status reply carries this field (its value is not shown). -->
    <string name="compat_f2_field_present" volt:screen="Compatibility results" volt:purpose="value">Present</string>
    <!-- Unfinished test card or notice: the try or guided test is still in progress, so it cannot be reviewed yet. -->
    <string name="compat_f2_test_still_running" volt:screen="Compatibility unfinished card" volt:purpose="status">The test is still running.</string>
</resources>
