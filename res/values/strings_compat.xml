<?xml version="1.0" encoding="utf-8"?>
<!--
  Compatibility and guided tests (batch B9): More › Developer options › Compatibility (the scooter's
  identity, the read-only check and its results, running and unfinished tries and guided tests, the
  report preview), the notes and reviews of a try or guided test, and the line that says release notes
  are in English. The English must stay exactly what the source said before the batch (G1, G2).

  The compatibility report itself, the command and event logs and every email stay English (plan G9):
  nothing here is ever written into them. Where the source added a word to a sentence ("Try · " or
  "Test · ", "expanded" or "collapsed"), each combination is its own whole template here, so a language
  can order, join and inflect the whole phrase. Only values (a setting's name, a value, a code, a count)
  are filled in.
-->
<resources xmlns:volt="https://volt.jjricks.com/ns/l10n"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ===== Panel: start, identity and the check ===== -->

    <!-- Shown while Volt's scooter service has not started yet. -->
    <string name="compat_service_starting" volt:screen="Compatibility" volt:purpose="status">Your local scooter service is starting.</string>
    <!-- Button: connect to the scooter. -->
    <string name="compat_connect" volt:screen="Compatibility" volt:purpose="button">Connect</string>
    <!-- Shown on the recovery route when no unfinished try or test is waiting. -->
    <string name="compat_no_unfinished_tests" volt:screen="Compatibility" volt:purpose="status">No unfinished tests.</string>
    <!-- Button: start the read-only compatibility check. It only reads from the scooter. -->
    <string name="compat_run_check" volt:screen="Compatibility" volt:purpose="button">Run check</string>
    <!-- Button: run the read-only compatibility check again. -->
    <string name="compat_run_again" volt:screen="Compatibility" volt:purpose="button">Run again</string>
    <!-- Button: draft an email to Volt with the compatibility report (the owner sends it). -->
    <string name="compat_email" volt:screen="Compatibility" volt:purpose="button" volt:dnt="Volt">Email to Volt</string>
    <!-- Button: show the report before anything is shared. -->
    <string name="compat_preview_report" volt:screen="Compatibility" volt:purpose="button">Preview report</string>
    <!-- Toast when there is no finished check to report yet. -->
    <string name="compat_no_finished_check" volt:screen="Compatibility" volt:purpose="toast">No finished check yet</string>
    <!-- Caption at the foot of the panel. "More › Experimental controls" names a place in the app. -->
    <string name="compat_footer" volt:screen="Compatibility" volt:purpose="caption" volt:safety="disclaimer">The check only reads. Tries are in More › Experimental controls, and the report includes their results. Never changes firmware.</string>
    <!-- Shown when no scooter is connected. -->
    <string name="compat_connect_to_check" volt:screen="Compatibility" volt:purpose="status">Connect to check this scooter.</string>
    <!-- Title of the identity card when the scooter's model ID was not captured. -->
    <string name="compat_model_not_captured" volt:screen="Compatibility identity" volt:purpose="title">Model ID not captured</string>
    <!-- Shown under the title for Volt's simulated scooter. -->
    <string name="compat_simulated" volt:screen="Compatibility identity" volt:purpose="label">Simulated scooter</string>
    <!-- Identity line: one fact about the scooter. %1$s is the fact's name ("Model ID", "Region"), %2$s its value. -->
    <string name="compat_identity_line" volt:screen="Compatibility identity" volt:purpose="label">%1$s · %2$s</string>
    <!-- Name of the identity line for the scooter's model ID (a number the scooter broadcasts). -->
    <string name="compat_model_id" volt:screen="Compatibility identity" volt:purpose="label">Model ID</string>
    <!-- Model ID line value: read from the scooter's broadcast. -->
    <string name="compat_model_id_advertised" volt:screen="Compatibility identity" volt:purpose="value">Advertised</string>
    <!-- Model ID line value: guessed from the serial number, not confirmed. -->
    <string name="compat_model_id_serial" volt:screen="Compatibility identity" volt:purpose="value">From serial (unconfirmed)</string>
    <!-- Model ID line value: no model ID was captured. -->
    <string name="compat_model_id_not_captured" volt:screen="Compatibility identity" volt:purpose="value">Not captured</string>
    <!-- Name of the identity line that reports a problem with the check. -->
    <string name="compat_check" volt:screen="Compatibility identity" volt:purpose="label">Check</string>
    <!-- Check line value: the broadcast and serial model IDs disagree. -->
    <string name="compat_model_id_mismatch" volt:screen="Compatibility identity" volt:purpose="value">Model ID mismatch</string>
    <!-- Name of the identity line for the sales region read from the serial number. -->
    <string name="compat_region" volt:screen="Compatibility identity" volt:purpose="label">Region</string>
    <!-- Region line value when the serial number gives no region. -->
    <string name="compat_region_unknown" volt:screen="Compatibility identity" volt:purpose="value">Unknown</string>
    <!-- Region line value: %1$s is the region code as the serial number writes it ("US", "EU"). -->
    <string name="compat_region_from_serial" volt:screen="Compatibility identity" volt:purpose="value">%1$s (from serial)</string>
    <!-- Name of the identity line for the dashboard (meter) firmware version. -->
    <string name="compat_firmware" volt:screen="Compatibility identity" volt:purpose="label">Firmware</string>
    <!-- Firmware line value before the version was read. -->
    <string name="compat_firmware_not_read" volt:screen="Compatibility identity" volt:purpose="value">Not read yet</string>
    <!-- Name of the identity line for the rules Volt uses for this model. -->
    <string name="compat_rules" volt:screen="Compatibility identity" volt:purpose="label">Rules</string>
    <!-- Name of the identity line for the model the owner said they have. -->
    <string name="compat_your_answer" volt:screen="Compatibility identity" volt:purpose="label">Your answer</string>
    <!-- Explains the Identify button below it. -->
    <string name="compat_identify_note" volt:screen="Compatibility identity" volt:purpose="description">Identify reads the model ID from the scooter\'s broadcast. It sends no command.</string>
    <!-- Button: read the model ID from the scooter's broadcast. -->
    <string name="compat_identify" volt:screen="Compatibility identity" volt:purpose="button">Identify</string>
    <!-- Rules line value: the NAVEE UT5 MAX's own rules. A model name, kept as written. -->
    <string name="compat_layer_ut5_max" volt:screen="Compatibility identity" volt:purpose="value" volt:dnt="UT5 MAX">UT5 MAX</string>
    <!-- Rules line value: rules mapped from the official app for this model group, not tested by Volt. -->
    <string name="compat_layer_oem" volt:screen="Compatibility identity" volt:purpose="value" volt:dnt="OEM">OEM-mapped (untested)</string>
    <!-- Rules line value: only the lock and readings shared by every model. -->
    <string name="compat_layer_shared" volt:screen="Compatibility identity" volt:purpose="value">Lock and readings</string>
    <!-- Rules line value: Volt does not support this model. -->
    <string name="compat_layer_none" volt:screen="Compatibility identity" volt:purpose="value">Not supported</string>

    <!-- ===== Running and unfinished tries and tests ===== -->

    <!-- Exactly one unfinished test on another saved scooter, which is reviewed there. -->
    <string name="compat_test_elsewhere_one" volt:screen="Compatibility" volt:purpose="status" volt:safety="experimental">1 unfinished test on another scooter. Select it to review.</string>
    <!-- Two or more unfinished tests on other saved scooters (one is compat_test_elsewhere_one). %1$d is how many. -->
    <string name="compat_tests_elsewhere" volt:screen="Compatibility" volt:purpose="status" volt:safety="experimental">%1$d unfinished tests on other scooters. Select one to review.</string>
    <!-- Shown when Volt cannot read its record of tries and tests (the same text as the test journal's own
         note): an earlier change may still be on the scooter. -->
    <string name="compat_test_records_unavailable" volt:screen="Compatibility" volt:purpose="warning" volt:safety="experimental">Test records unavailable. A previous test may not have been set back; check the scooter\'s settings.</string>
    <!-- Title of the card for a running try (a setting tried from Experimental controls). %1$s is the setting's name. -->
    <string name="compat_try_title" volt:screen="Compatibility try card" volt:purpose="title">Try · %1$s</string>
    <!-- Title of the card for a running guided test. %1$s is the setting's name. -->
    <string name="compat_test_title" volt:screen="Compatibility try card" volt:purpose="title">Test · %1$s</string>
    <!-- Status while Volt reads the setting's value before changing anything. -->
    <string name="compat_reading_current" volt:screen="Compatibility try card" volt:purpose="status">Reading the current value…</string>
    <!-- Status while the scooter changes to the value being tried. %1$s is that value ("On", "25 km/h"). -->
    <string name="compat_changing_to" volt:screen="Compatibility try card" volt:purpose="status" volt:safety="experimental">Changing to %1$s…</string>
    <!-- Status while Volt reads the setting again to check that nothing changed. -->
    <string name="compat_checking_unchanged" volt:screen="Compatibility try card" volt:purpose="status" volt:safety="experimental">Checking it is unchanged…</string>
    <!-- Status while the scooter goes back to the value it had. %1$s is that value. -->
    <string name="compat_setting_back" volt:screen="Compatibility try card" volt:purpose="status" volt:safety="experimental">Setting it back to %1$s…</string>
    <!-- Answer to the try's question: yes, the owner saw the change. -->
    <string name="compat_yes" volt:screen="Compatibility try card" volt:purpose="button">Yes</string>
    <!-- Answer to the try's question: no, the owner did not see the change. -->
    <string name="compat_no" volt:screen="Compatibility try card" volt:purpose="button">No</string>
    <!-- Button: do not answer the try's question. -->
    <string name="compat_skip" volt:screen="Compatibility try card" volt:purpose="button">Skip</string>
    <!-- A finished try kept its value; Set back is a button in Experimental controls. -->
    <string name="compat_kept_set_back" volt:screen="Compatibility try card" volt:purpose="status" volt:safety="experimental">Kept · Set back is in Experimental controls</string>
    <!-- A finished try kept its value. -->
    <string name="compat_kept" volt:screen="Compatibility try card" volt:purpose="status" volt:safety="experimental">Kept</string>
    <!-- The scooter was read back at its earlier value after the test. -->
    <string name="compat_restoration_confirmed" volt:screen="Compatibility try card" volt:purpose="status" volt:safety="experimental">Restoration confirmed</string>
    <!-- The earlier value is not confirmed back yet; the card below reviews it. -->
    <string name="compat_restoration_outstanding" volt:screen="Compatibility try card" volt:purpose="status" volt:safety="experimental">Restoration outstanding · review below</string>
    <!-- Title of the card for an unfinished try. %1$s is the setting's name. -->
    <string name="compat_unfinished_try_title" volt:screen="Compatibility unfinished card" volt:purpose="title">Unfinished try · %1$s</string>
    <!-- Title of the card for an unfinished guided test. %1$s is the setting's name. -->
    <string name="compat_unfinished_test_title" volt:screen="Compatibility unfinished card" volt:purpose="title">Unfinished test · %1$s</string>
    <!-- Line name: the value the setting had before the try. -->
    <string name="compat_before_try" volt:screen="Compatibility unfinished card" volt:purpose="label">Before the try</string>
    <!-- Line name: the value the setting had before the test. -->
    <string name="compat_before_test" volt:screen="Compatibility unfinished card" volt:purpose="label">Before the test</string>
    <!-- Line name: the value the try set. -->
    <string name="compat_value_tried" volt:screen="Compatibility unfinished card" volt:purpose="label">Value tried</string>
    <!-- Line name: the value the test set. -->
    <string name="compat_test_value" volt:screen="Compatibility unfinished card" volt:purpose="label">Test value</string>
    <!-- Switch: the owner confirms the scooter is parked, so Volt may set the value back. -->
    <string name="compat_parked" volt:screen="Compatibility unfinished card" volt:purpose="switch label" volt:safety="ride">Scooter is parked</string>
    <!-- Under the switch: the scooter has not reported whether it is moving on this connection. -->
    <string name="compat_parked_no_motion" volt:screen="Compatibility unfinished card" volt:purpose="description" volt:safety="ride">No motion report yet on this connection.</string>
    <!-- Button: go on although the scooter's firmware changed since the test. -->
    <string name="compat_continue_anyway" volt:screen="Compatibility unfinished card" volt:purpose="button" volt:safety="experimental">Continue anyway</string>
    <!-- Button: the setting is already back to its earlier value; mark the test finished. -->
    <string name="compat_mark_restored" volt:screen="Compatibility unfinished card" volt:purpose="button" volt:safety="experimental">Mark restored</string>
    <!-- Button: write the earlier value back. %1$s is that value. -->
    <string name="compat_restore_to" volt:screen="Compatibility unfinished card" volt:purpose="button" volt:safety="experimental">Restore to %1$s</string>
    <!-- Button: keep the value the scooter has now. %1$s is that value. -->
    <string name="compat_keep_value" volt:screen="Compatibility unfinished card" volt:purpose="button" volt:safety="experimental">Keep %1$s</string>
    <!-- Button: set the earlier value again. %1$s is that value. -->
    <string name="compat_set_value" volt:screen="Compatibility unfinished card" volt:purpose="button" volt:safety="experimental">Set %1$s</string>
    <!-- Button: close the unfinished card without changing the scooter. -->
    <string name="compat_dismiss_leave" volt:screen="Compatibility unfinished card" volt:purpose="button" volt:safety="experimental">Dismiss · leave as is</string>
    <!-- Spoken description of the Dismiss button on an unfinished try. %1$s is the setting's name. -->
    <string name="compat_dismiss_try_description" volt:screen="Compatibility unfinished card" volt:purpose="accessibility description" volt:safety="experimental">Dismiss the unfinished %1$s try without restoring it</string>
    <!-- Spoken description of the Dismiss button on an unfinished test. %1$s is the setting's name. -->
    <string name="compat_dismiss_test_description" volt:screen="Compatibility unfinished card" volt:purpose="accessibility description" volt:safety="experimental">Dismiss the unfinished %1$s test without restoring it</string>
    <!-- On an unfinished test whose scooter was removed from Volt. -->
    <string name="compat_orphan_body" volt:screen="Compatibility unfinished card" volt:purpose="description" volt:safety="experimental">Its scooter was forgotten, so Volt can\'t check this setting or set it back. Check it on the scooter itself.</string>
    <!-- Button: close the card of a forgotten scooter's test. -->
    <string name="compat_dismiss" volt:screen="Compatibility unfinished card" volt:purpose="button">Dismiss</string>
    <!-- Spoken description of Dismiss on a forgotten scooter's test. %1$s is the setting's name. -->
    <string name="compat_dismiss_orphan_description" volt:screen="Compatibility unfinished card" volt:purpose="accessibility description">Dismiss the unfinished %1$s test of a forgotten scooter</string>

    <!-- ===== The try's question ===== -->

    <!-- Question while the dashboard units are being tried: the value tried shows miles per hour. -->
    <string name="compat_question_units_mph" volt:screen="Compatibility try card" volt:purpose="question" volt:dnt="mph">Does the dashboard show mph?</string>
    <!-- Question while the dashboard units are being tried: the value tried shows kilometres per hour. -->
    <string name="compat_question_units_kmh" volt:screen="Compatibility try card" volt:purpose="question" volt:dnt="km/h">Does the dashboard show km/h?</string>
    <!-- Question while the tail light is tried on. -->
    <string name="compat_question_tail_light_on" volt:screen="Compatibility try card" volt:purpose="question">Is the tail light on?</string>
    <!-- Question while the tail light is tried off. -->
    <string name="compat_question_tail_light_off" volt:screen="Compatibility try card" volt:purpose="question">Is the tail light off?</string>
    <!-- Question while the tail light is tried at another value. %1$s is that value's name in lower case. -->
    <string name="compat_question_tail_light" volt:screen="Compatibility try card" volt:purpose="question">Is the tail light %1$s?</string>
    <!-- Question while the turn signal sound is tried on. -->
    <string name="compat_question_turn_sound_on" volt:screen="Compatibility try card" volt:purpose="question">With a turn signal on, is the sound on?</string>
    <!-- Question while the turn signal sound is tried off. -->
    <string name="compat_question_turn_sound_off" volt:screen="Compatibility try card" volt:purpose="question">With a turn signal on, is the sound off?</string>
    <!-- Question while the turn signal sound is tried at another value. %1$s is that value's name in lower case. -->
    <string name="compat_question_turn_sound" volt:screen="Compatibility try card" volt:purpose="question">With a turn signal on, is the sound %1$s?</string>
    <!-- Question while automatic lights are tried on. -->
    <string name="compat_question_auto_lights_on" volt:screen="Compatibility try card" volt:purpose="question">Are automatic lights on?</string>
    <!-- Question while automatic lights are tried off. -->
    <string name="compat_question_auto_lights_off" volt:screen="Compatibility try card" volt:purpose="question">Are automatic lights off?</string>
    <!-- Question while automatic lights are tried at another value. %1$s is that value's name in lower case. -->
    <string name="compat_question_auto_lights" volt:screen="Compatibility try card" volt:purpose="question">Are automatic lights %1$s?</string>
    <!-- Question while the range estimate is tried. -->
    <string name="compat_question_range" volt:screen="Compatibility try card" volt:purpose="question">Did the range estimate on the dashboard change?</string>
    <!-- Question while any other setting is tried. -->
    <string name="compat_question_default" volt:screen="Compatibility try card" volt:purpose="question">Did you see it change?</string>

    <!-- ===== The check's progress and results ===== -->

    <!-- Button: stop the running check. -->
    <string name="compat_stop" volt:screen="Compatibility" volt:purpose="button">Stop</string>
    <!-- Progress after every read: Volt waits for reports the scooter sends by itself. -->
    <string name="compat_listening" volt:screen="Compatibility" volt:purpose="status">Listening for scooter reports…</string>
    <!-- Progress of the check. %1$s is the read in progress, %2$s how many reads there are. -->
    <string name="compat_reading_progress" volt:screen="Compatibility" volt:purpose="status">Reading %1$s of %2$s…</string>
    <!-- Shown above the results of a check that was interrupted. -->
    <string name="compat_check_interrupted" volt:screen="Compatibility results" volt:purpose="status">The check was interrupted. Results so far:</string>
    <!-- Heading of the group of read results. -->
    <string name="compat_group_reads" volt:screen="Compatibility results" volt:purpose="heading">Reads</string>
    <!-- Heading of the group of status fields. -->
    <string name="compat_group_fields" volt:screen="Compatibility results" volt:purpose="heading">Fields</string>
    <!-- Heading of the group of controls. -->
    <string name="compat_group_controls" volt:screen="Compatibility results" volt:purpose="heading">Controls</string>
    <!-- Beside a group heading: tap to collapse the group. -->
    <string name="compat_group_hide" volt:screen="Compatibility results" volt:purpose="button">Hide</string>
    <!-- Beside a group heading: tap to expand the group. -->
    <string name="compat_group_show" volt:screen="Compatibility results" volt:purpose="button">Show</string>
    <!-- Spoken description of an expanded group heading. %1$s is the group's name. -->
    <string name="compat_group_expanded" volt:screen="Compatibility results" volt:purpose="accessibility description">%1$s, expanded</string>
    <!-- Spoken description of a collapsed group heading. %1$s is the group's name. -->
    <string name="compat_group_collapsed" volt:screen="Compatibility results" volt:purpose="accessibility description">%1$s, collapsed</string>
    <!-- Title of a read result: %1$s is the read's command code ("0x70"), %2$s the read's name. -->
    <string name="compat_read_title" volt:screen="Compatibility results" volt:purpose="label">%1$s · %2$s</string>
    <!-- Row: the reports the scooter sent by itself. -->
    <string name="compat_reports" volt:screen="Compatibility results" volt:purpose="label">Reports from the scooter</string>
    <!-- Reports row value when the scooter sent none. -->
    <string name="compat_reports_none" volt:screen="Compatibility results" volt:purpose="value">None seen (they may only arrive while riding)</string>
    <!-- The scooter's status read (command 0x70): a read's name, and the Fields row when it did not arrive. -->
    <string name="compat_read_status" volt:screen="Compatibility results" volt:purpose="label">Status</string>
    <!-- Status row value when the status read did not arrive. -->
    <string name="compat_status_not_received" volt:screen="Compatibility results" volt:purpose="value">Not received</string>
    <!-- Fields row: how long ago the status was read. -->
    <string name="compat_status_read" volt:screen="Compatibility results" volt:purpose="label">Read</string>
    <!-- The controls row for the scooter's clock. -->
    <string name="compat_control_clock" volt:screen="Compatibility results" volt:purpose="label">Clock</string>
    <!-- A control's row value when Volt offers it. %1$s is the evidence for it ("Volt-verified", "Shared"). -->
    <string name="compat_control_available" volt:screen="Compatibility results" volt:purpose="value">Available · %1$s</string>
    <!-- A control's row value when Volt does not offer it. %1$s is why, %2$s the evidence for it. -->
    <string name="compat_control_unavailable" volt:screen="Compatibility results" volt:purpose="value">%1$s · %2$s</string>
    <!-- How long ago the status was read: just now. -->
    <string name="compat_age_just_now" volt:screen="Compatibility results" volt:purpose="value">Just now</string>
    <!-- How long ago the status was read: less than a minute. -->
    <string name="compat_age_under_minute" volt:screen="Compatibility results" volt:purpose="value">Under a minute ago</string>
    <!-- How long ago the status was read: exactly one minute. -->
    <string name="compat_age_one_minute" volt:screen="Compatibility results" volt:purpose="value">1 minute ago</string>
    <!-- How long ago the status was read, two minutes or more (one is compat_age_one_minute). %1$d is the number of minutes. -->
    <string name="compat_age_minutes" volt:screen="Compatibility results" volt:purpose="value">%1$d minutes ago</string>
    <!-- Name of a read: the serial number check (command 0x74). -->
    <string name="compat_read_serial" volt:screen="Compatibility results" volt:purpose="label">Serial check</string>
    <!-- Name of a read: the firmware versions (command 0x73). -->
    <string name="compat_read_firmware" volt:screen="Compatibility results" volt:purpose="label">Firmware</string>
    <!-- Name of a read: the battery (command 0x72). -->
    <string name="compat_read_battery" volt:screen="Compatibility results" volt:purpose="label">Battery</string>
    <!-- Name of a read: the ride history (command 0x76). -->
    <string name="compat_read_ride_history" volt:screen="Compatibility results" volt:purpose="label">Ride history</string>
    <!-- Name of a read: the fault history (command 0x7b). -->
    <string name="compat_read_fault_history" volt:screen="Compatibility results" volt:purpose="label">Fault history</string>
    <!-- Name of a probing read: driving data (command 0x71). -->
    <string name="compat_read_driving" volt:screen="Compatibility results" volt:purpose="label">Driving (probe)</string>
    <!-- Name of a probing read: the battery's identity (command 0x75). -->
    <string name="compat_read_battery_id" volt:screen="Compatibility results" volt:purpose="label">Battery ID (probe)</string>
    <!-- Name of a probing read: the battery's signs (command 0x79). -->
    <string name="compat_read_battery_signs" volt:screen="Compatibility results" volt:purpose="label">Battery signs (probe)</string>
    <!-- Name of any other read. -->
    <string name="compat_read_other" volt:screen="Compatibility results" volt:purpose="label">Read</string>
    <!-- Read result: the scooter rejected the read. %1$d is the scooter's status code. -->
    <string name="compat_read_rejected" volt:screen="Compatibility results" volt:purpose="value">Rejected %1$d</string>
    <!-- Read result: the reply was too short. %1$d is the reply's length in bytes. English keeps "1 bytes". -->
    <plurals name="compat_read_too_short" volt:screen="Compatibility results" volt:purpose="value" volt:english-fix="pending">
        <item quantity="one">Too short (%1$d bytes)</item>
        <item quantity="other">Too short (%1$d bytes)</item>
    </plurals>
    <!-- Read result: the scooter replied without data. -->
    <string name="compat_read_empty" volt:screen="Compatibility results" volt:purpose="value">Replied with no data</string>
    <!-- Read result: no reply. -->
    <string name="compat_read_no_response" volt:screen="Compatibility results" volt:purpose="value">No response</string>
    <!-- Read result: the check stopped before the reply. -->
    <string name="compat_read_interrupted" volt:screen="Compatibility results" volt:purpose="value">Interrupted</string>
    <!-- Read result: the reply has not arrived yet. -->
    <string name="compat_read_waiting" volt:screen="Compatibility results" volt:purpose="value">Waiting</string>
    <!-- Evidence for a control: tested by Volt on this model. -->
    <string name="compat_evidence_volt_verified" volt:screen="Compatibility results" volt:purpose="value" volt:dnt="Volt">Volt-verified</string>
    <!-- Evidence for a control: Volt's lab rules for this model. -->
    <string name="compat_evidence_lab" volt:screen="Compatibility results" volt:purpose="value">Lab</string>
    <!-- Evidence for a control: mapped from the official app (OEM), not tested by Volt. -->
    <string name="compat_evidence_oem" volt:screen="Compatibility results" volt:purpose="value" volt:dnt="OEM">OEM-mapped</string>
    <!-- Evidence for a control: shared by every model. -->
    <string name="compat_evidence_shared" volt:screen="Compatibility results" volt:purpose="value">Shared</string>
    <!-- Evidence for a control: a test on this phone. -->
    <string name="compat_evidence_local" volt:screen="Compatibility results" volt:purpose="value">Tested here</string>
    <!-- Evidence for a control: none. -->
    <string name="compat_evidence_none" volt:screen="Compatibility results" volt:purpose="value">No evidence</string>
    <!-- A result row's spoken description. %1$s is the row's name, %2$s its value. -->
    <string name="compat_row_description" volt:screen="Compatibility results" volt:purpose="accessibility description">%1$s: %2$s</string>

    <!-- ===== Report preview ===== -->

    <!-- Heading of the report preview (shown in capitals). -->
    <string name="compat_report_preview" volt:screen="Compatibility report preview" volt:purpose="heading">Report preview</string>
    <!-- What the report leaves out. MAC is a Bluetooth address; PIN is the scooter's PIN. -->
    <string name="compat_report_privacy" volt:screen="Compatibility report preview" volt:purpose="description" volt:safety="privacy" volt:dnt="MAC|PIN">Only what is shown here is shared. No serial, MAC, owner key, PIN, names or routes.</string>
    <!-- Shown above the report only in a translated app: the report below, and anything shared or emailed
         from it, stays in English. Never shown in English. -->
    <string name="compat_report_in_english" volt:screen="Compatibility report preview" volt:purpose="description">The report is in English.</string>
    <!-- Button: show the report as a readable summary. -->
    <string name="compat_show_summary" volt:screen="Compatibility report preview" volt:purpose="button">Show summary</string>
    <!-- Button: show the report's JSON (a data format). -->
    <string name="compat_show_json" volt:screen="Compatibility report preview" volt:purpose="button" volt:dnt="JSON">Show JSON</string>
    <!-- Spoken description of Show summary. -->
    <string name="compat_show_summary_description" volt:screen="Compatibility report preview" volt:purpose="accessibility description">Show report summary</string>
