<?xml version="1.0" encoding="utf-8"?>
<!--
  The Home dashboard screen (batch B13, DashboardScreen): the header and its edit tools, the charging
  card, the widget cards and their editor controls, the Add widget palette, the widget options, the
  shortcut and reading pickers, and the layout, size, position, scale and saved-slot dialogs. The
  English must stay exactly what the source said before the batch (G1, G2; the whole templates a
  condition picks are checked against the original chain by tests/l10n/DashboardScreenTextTest.java,
  and the numbers and names by tests/l10n/characterization/DashboardScreenEnglishTest.java).

  Stored values stay English: a widget's saved title and note, an export and an import keep the
  English text. Widget type names, default titles and slot names come from strings_dashboard_model.xml.
-->
<resources xmlns:volt="https://volt.jjricks.com/ns/l10n"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Header -->
    <!-- Tooltip of the status line under the scooter's name; a tap opens the connection details. -->
    <string name="dashboard_connection_details" volt:screen="Home header" volt:purpose="tooltip">Connection details</string>
    <!-- The header's name when no scooter is set up. -->
    <string name="dashboard_your_scooter" volt:screen="Home header" volt:purpose="title">Your scooter</string>
    <!-- Spoken for the pencil beside the scooter's name while editing the dashboard. -->
    <string name="dashboard_rename_scooter" volt:screen="Home header" volt:purpose="accessibility description">Rename scooter</string>
    <!-- Spoken for the undo arrow while editing the dashboard. -->
    <string name="dashboard_undo_edit" volt:screen="Home header, editing" volt:purpose="accessibility description">Undo dashboard edit</string>
    <!-- Spoken for the redo arrow while editing the dashboard. -->
    <string name="dashboard_redo_edit" volt:screen="Home header, editing" volt:purpose="accessibility description">Redo dashboard edit</string>
    <!-- Tooltip of the undo arrow. -->
    <string name="dashboard_undo" volt:screen="Home header, editing" volt:purpose="tooltip">Undo</string>
    <!-- Tooltip of the redo arrow. -->
    <string name="dashboard_redo" volt:screen="Home header, editing" volt:purpose="tooltip">Redo</string>
    <!-- Button that opens the widget palette, and the palette's title. -->
    <string name="dashboard_add_widget" volt:screen="Home, editing" volt:purpose="button">Add widget</string>
    <!-- Button that opens the dashboard layout sheet. -->
    <string name="dashboard_layout" volt:screen="Home, editing" volt:purpose="button">Layout</string>
    <!-- Spoken for the header's Done pill while editing. -->
    <string name="dashboard_finish_editing" volt:screen="Home header, editing" volt:purpose="accessibility description">Finish editing dashboard</string>
    <!-- Spoken for the header's pencil, which starts editing the dashboard. -->
    <string name="dashboard_edit_dashboard" volt:screen="Home header" volt:purpose="accessibility description">Edit dashboard</string>
    <!-- Why no widget can be added or duplicated: a dashboard holds at most 32 widgets. -->
    <string name="dashboard_widget_limit" volt:screen="Home, editing" volt:purpose="tooltip">32-widget limit</string>
    <!-- Spoken for Add widget at the limit: %1$s is dashboard_widget_limit. -->
    <string name="dashboard_add_widget_limit" volt:screen="Home, editing" volt:purpose="accessibility description">Add widget, %1$s</string>
    <!-- The status line while Volt connects; the last character (an object replacement character) is
         replaced by a small spinner, so keep it last and keep the two spaces before it. -->
    <string name="dashboard_connecting_spinner" volt:screen="Home header" volt:purpose="status" volt:dnt="￼">"Connecting…  ￼"</string>
    <!-- Tooltip of a widget's duplicate button: a dashboard has a single lock widget. -->
    <string name="dashboard_one_lock_widget" volt:screen="Home, editing a widget" volt:purpose="tooltip" volt:safety="lock">One lock widget per dashboard</string>
    <!-- Tooltip of a widget's duplicate button. -->
    <string name="dashboard_duplicate_widget" volt:screen="Home, editing a widget" volt:purpose="tooltip">Duplicate widget</string>
    <!-- Card ages, beside a clock glyph on a card's footer (narrow: keep them as short as English). -->
    <!-- The card's reading is less than a minute old. -->
    <string name="dashboard_age_now" volt:screen="Home cards" volt:purpose="value">now</string>
    <!-- The reading's age: %1$s is a whole number of minutes (1 to 59). -->
    <string name="dashboard_age_minutes" volt:screen="Home cards" volt:purpose="value">%1$s min</string>
    <!-- The reading's age: %1$s is a whole number of hours (1 to 23). -->
    <string name="dashboard_age_hours" volt:screen="Home cards" volt:purpose="value">%1$s h</string>
    <!-- The reading's age: %1$s is a whole number of days. -->
    <string name="dashboard_age_days" volt:screen="Home cards" volt:purpose="value">%1$s d</string>

    <!-- Readings -->
    <!-- The scooter's own range estimate, rounded: %1$s is a distance with its unit ("31 mi"). -->
    <string name="dashboard_about" volt:screen="Home battery cards" volt:purpose="value" volt:safety="ride">about %1$s</string>
    <!-- Name of the scooter's own range reading on the dashboard. -->
    <string name="dashboard_estimated_range" volt:screen="Home cards, reading pickers" volt:purpose="reading name" volt:safety="ride">Estimated remaining range</string>
    <!-- Name of the drive mode reading on the dashboard. -->
    <string name="dashboard_drive_mode" volt:screen="Home cards, reading pickers" volt:purpose="reading name">Drive mode</string>

    <!-- Charging -->
    <!-- The charging time when the battery is already at its target. -->
    <string name="dashboard_at_target" volt:screen="Home charging card" volt:purpose="value" volt:safety="charge">At target</string>
    <!-- The estimated charging time: %1$s is whole hours, %2$s whole minutes (0 to 59), "≈ 1h 20m". -->
    <string name="dashboard_duration_hours" volt:screen="Home charging card" volt:purpose="value" volt:safety="charge">≈ %1$sh %2$sm</string>
    <!-- The estimated charging time under an hour: %1$s is whole minutes, "≈ 20m". -->
    <string name="dashboard_duration_minutes" volt:screen="Home charging card" volt:purpose="value" volt:safety="charge">≈ %1$sm</string>
    <!-- Name of the charging time on the charging widget when a charge limit is set: %1$s is the
         limit as a percentage (fmt_percent, "80%"). -->
    <string name="dashboard_charge_to_limit" volt:screen="Home charging widget" volt:purpose="label" volt:safety="charge">To %1$s limit</string>
    <!-- Name of the charging time on the charging card when a charge limit is set: %1$s is the limit as
         a percentage (fmt_percent, "80%"). -->
    <string name="dashboard_charge_time_to" volt:screen="Home charging card" volt:purpose="label" volt:ladder="full" volt:safety="charge">Time to %1$s</string>
    <!-- The narrowest name of the charging time to a charge limit (both cards): %1$s is the limit as a
         percentage. -->
    <string name="dashboard_charge_time_to_compact" volt:screen="Narrow Home charging cards" volt:purpose="label" volt:ladder="compact" volt:safety="charge">To %1$s</string>
    <!-- Name of the charging time when the scooter does not report its charge limit: the time to 100%
         assumes no limit. -->
    <string name="dashboard_charge_time_uncapped" volt:screen="Home charging cards" volt:purpose="label" volt:ladder="full" volt:safety="charge" formatted="false">Time to 100% if uncapped</string>
    <string name="dashboard_charge_time_uncapped_short" volt:screen="Home charging cards" volt:purpose="label" volt:ladder="short" volt:safety="charge" formatted="false">To 100% if uncapped</string>
    <string name="dashboard_charge_time_uncapped_compact" volt:screen="Narrow Home charging cards" volt:purpose="label" volt:ladder="compact" volt:safety="charge" formatted="false">100% if uncapped</string>
    <!-- Name of the estimated charging time to a full battery (no charge limit below 100%). -->
    <string name="dashboard_charge_time_full" volt:screen="Home charging cards" volt:purpose="label" volt:ladder="full" volt:safety="charge">Time to full (est.)</string>
    <string name="dashboard_charge_time_full_short" volt:screen="Home charging cards" volt:purpose="label" volt:ladder="short" volt:safety="charge">Time to full (est.)</string>
    <string name="dashboard_charge_time_full_compact" volt:screen="Narrow Home charging cards" volt:purpose="label" volt:ladder="compact" volt:safety="charge">To full (est.)</string>
    <!-- The charging state when the charging current is too low for a time estimate (ChargingEstimate's
         LOW_CURRENT), shown as an orange chip. -->
    <string name="dashboard_low_current" volt:screen="Home charging cards" volt:purpose="status" volt:safety="charge">Low current</string>
    <!-- Name of the charging power cell. -->
    <string name="dashboard_charging_power" volt:screen="Home charging cards" volt:purpose="label" volt:safety="charge">Charging power</string>
    <!-- The charging power cell's name when the cell is narrow. -->
    <string name="dashboard_charging_power_compact" volt:screen="Narrow Home charging cards" volt:purpose="label" volt:safety="charge">Power</string>
    <!-- Name of the charging time cell. -->
    <string name="dashboard_time_to_full" volt:screen="Home charging cards" volt:purpose="label" volt:safety="charge">Time to full</string>
    <!-- The chip above the charging hero's battery level. -->
    <string name="dashboard_charging" volt:screen="Home charging hero" volt:purpose="status" volt:safety="charge">Charging</string>
    <!-- The chip when a charge limit is set: %1$s is the limit, a whole number, followed by the
         percent sign. -->
    <string name="dashboard_charging_limit" volt:screen="Home charging hero" volt:purpose="status" volt:safety="charge">Charging · limit %1$s%%</string>
    <!-- Spoken for the charging hero's photo. The photo is a NAVEE UT5 MAX whatever the model (a known
         English wording, kept until the hero names the model). -->
    <string name="dashboard_hero_photo" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:dnt="NAVEE UT5 MAX">NAVEE UT5 MAX scooter</string>
    <!-- Spoken for the charging hero's level when the scooter does not report it. -->
    <string name="dashboard_battery_not_reported" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:safety="charge">Battery not reported</string>
    <!-- Spoken for the charging hero's level: %1$d is the battery level, a whole number from 0 to 100.
         English says "percent" for every number. -->
    <plurals name="dashboard_battery_percent" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:safety="charge">
        <item quantity="one">Battery %1$d percent</item>
        <item quantity="other">Battery %1$d percent</item>
    </plurals>
    <!-- Spoken for the charging time, and its tooltip: %1$s is the time's name (dashboard_charge_time_*),
         %2$s the time ("≈ 1h 20m") or a short state. -->
    <string name="dashboard_hero_time" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:safety="charge">%1$s, %2$s</string>
    <!-- The same with the state chip: %3$s is the chip's state ("Low current"). -->
    <string name="dashboard_hero_time_tag" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:safety="charge">%1$s, %2$s, %3$s</string>
    <!-- The same with the estimate's explanation: %3$s is a sentence about the estimate. -->
    <string name="dashboard_hero_time_status" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:safety="charge">%1$s, %2$s. %3$s</string>
    <!-- The same with the chip (%3$s) and the explanation (%4$s). -->
    <string name="dashboard_hero_time_tag_status" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:safety="charge">%1$s, %2$s, %3$s. %4$s</string>
    <!-- Spoken for the charging hero's photo stage when the level is not reported. -->
    <string name="dashboard_hero_charge_not_reported" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:safety="charge">Charge not reported</string>
    <!-- The same with a charge limit: %1$s is the limit, a whole number of percent. -->
    <string name="dashboard_hero_charge_not_reported_limit" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:safety="charge">Charge not reported, charge limit %1$s percent</string>
    <!-- Spoken for the photo stage: %1$s is the battery level, a whole number of percent. -->
    <string name="dashboard_hero_charge" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:safety="charge">Charge %1$s percent</string>
    <!-- The same with a charge limit: %1$s is the level, %2$s the limit, whole numbers of percent. -->
    <string name="dashboard_hero_charge_limit" volt:screen="Home charging hero" volt:purpose="accessibility description" volt:safety="charge">Charge %1$s percent, charge limit %2$s percent</string>
    <!-- Name of the battery temperature on the charging cards. -->
    <string name="dashboard_battery_temperature" volt:screen="Home charging cards" volt:purpose="label" volt:safety="charge">Battery temperature</string>
    <!-- Spoken after the charging power: the power is measured on the battery side. -->
    <string name="dashboard_battery_side_power" volt:screen="Home charging cards" volt:purpose="accessibility description" volt:safety="charge">Battery-side power</string>
    <!-- Spoken name of the charging time with its state chip: %1$s is the time's name
         (dashboard_charge_time_*), %2$s the chip's state ("Low current"). -->
    <string name="dashboard_charging_time_tag" volt:screen="Home charging cards" volt:purpose="accessibility description" volt:safety="charge">%1$s (%2$s)</string>
    <!-- Spoken for a charging cell: %1$s is the cell's name, %2$s its value ("412 W", "≈ 1h 20m"). -->
    <string name="dashboard_charging_description" volt:screen="Home charging cards" volt:purpose="accessibility description" volt:safety="charge">%1$s, %2$s</string>
    <!-- The same with an explanation: %3$s is a sentence or a short note ("Battery-side power"). -->
    <string name="dashboard_charging_description_detail" volt:screen="Home charging cards" volt:purpose="accessibility description" volt:safety="charge">%1$s, %2$s. %3$s</string>
    <!-- Editing a widget -->
    <!-- Spoken for a widget's move handle: %1$s is the widget's title. -->
    <string name="dashboard_move_widget_named" volt:screen="Home, editing a widget" volt:purpose="accessibility description">Move %1$s</string>
    <!-- Spoken for a widget's resize corner: %1$s is the widget's title. -->
    <string name="dashboard_resize_widget_named" volt:screen="Home, editing a widget" volt:purpose="accessibility description">Resize %1$s</string>
    <!-- Spoken for a widget's options button: %1$s is the widget's title. -->
    <string name="dashboard_options_for" volt:screen="Home, editing a widget" volt:purpose="accessibility description">Options for %1$s</string>
    <!-- Spoken for a widget's duplicate button: %1$s is the widget's title. -->
    <string name="dashboard_duplicate_named" volt:screen="Home, editing a widget" volt:purpose="accessibility description">Duplicate %1$s</string>
    <!-- Spoken for a widget's remove button: %1$s is the widget's title. -->
    <string name="dashboard_remove_named" volt:screen="Home, editing a widget" volt:purpose="accessibility description">Remove %1$s</string>
    <!-- A small widget's action menu, and its move handle's tooltip. -->
    <string name="dashboard_move_widget" volt:screen="Home, editing a widget" volt:purpose="menu item">Move widget</string>
    <string name="dashboard_edit_widget" volt:screen="Home, editing a widget" volt:purpose="menu item">Edit widget</string>
    <string name="dashboard_remove_widget" volt:screen="Home, editing a widget" volt:purpose="menu item">Remove widget</string>
    <!-- Tooltip of a small widget's handle, which opens the action menu. -->
    <string name="dashboard_move_or_edit_widget" volt:screen="Home, editing a widget" volt:purpose="tooltip">Move or edit widget</string>

    <!-- Widget cards -->
    <!-- Spoken for the scooter glyph a scooter widget shows when Volt has no photo of the model. -->
    <string name="dashboard_scooter" volt:screen="Home scooter widget" volt:purpose="accessibility description">Scooter</string>
    <!-- Long-press note of the battery health widget: the health is what the scooter's controller
         reports, not a measured capacity test. -->
    <string name="dashboard_controller_reported" volt:screen="Home battery health widget" volt:purpose="tooltip">Controller-reported, not a capacity test</string>
    <!-- The capacity widget's value while its first estimate is computed. -->
    <string name="dashboard_processing" volt:screen="Home capacity widget" volt:purpose="status" volt:safety="experimental">Processing…</string>
    <!-- Button that sets the capacity to compare the estimate with. -->
    <string name="dashboard_set_reference" volt:screen="Home capacity widget" volt:purpose="button" volt:safety="experimental">Set reference</string>
    <!-- Spoken for Set reference. -->
    <string name="dashboard_set_reference_capacity" volt:screen="Home capacity widget" volt:purpose="accessibility description" volt:safety="experimental">Set reference capacity</string>
    <!-- The capacity widget's summary while it reads the recorded rides. -->
    <string name="dashboard_checking_rides" volt:screen="Home capacity widget" volt:purpose="status" volt:safety="experimental">Checking recorded rides…</string>
    <!-- Button that opens the capacity estimate's evidence. -->
    <string name="dashboard_estimate_details" volt:screen="Home capacity widget" volt:purpose="button" volt:safety="experimental">Estimate details</string>
    <!-- A note widget with no text yet. -->
    <string name="dashboard_empty_note" volt:screen="Home note widget" volt:purpose="placeholder">Empty note</string>
    <!-- Spoken for a note widget while editing: %1$s is the note's text. -->
    <string name="dashboard_edit_note" volt:screen="Home note widget, editing" volt:purpose="accessibility description">%1$s. Edit note</string>
    <!-- Spoken for an empty note widget while editing. -->
    <string name="dashboard_empty_note_edit" volt:screen="Home note widget, editing" volt:purpose="accessibility description">Empty note. Edit note</string>
    <!-- Title of the note editor and the note's settings row. -->
    <string name="dashboard_note" volt:screen="Note widget options" volt:purpose="title">Note</string>
    <!-- The ride recorder widget's title and button. -->
    <string name="dashboard_record_ride" volt:screen="Home ride recorder widget" volt:purpose="button">Record ride</string>
    <!-- Spoken for the recorder's arrow, which opens the ride list. -->
    <string name="dashboard_view_rides" volt:screen="Home ride recorder widget" volt:purpose="accessibility description">View rides</string>
    <!-- Spoken for a reading the scooter has not sent: %1$s is the reading's name. -->
    <string name="dashboard_not_reported_named" volt:screen="Home cards" volt:purpose="accessibility description">%1$s, not reported</string>
    <!-- The battery overview widget's caption. -->
    <string name="dashboard_battery" volt:screen="Home battery overview widget" volt:purpose="label">Battery</string>
    <!-- The battery overview's range line: %1$s is the range ("about 31 mi"). -->
    <string name="dashboard_range_left" volt:screen="Home battery overview widget" volt:purpose="value" volt:safety="ride">%1$s left</string>
    <!-- Spoken for the battery overview widget. %1$s is the level, a whole number of percent; the
         _line forms add the range line (%1$s or %2$s: "about 31 mi left", or "Charging"); the _seen
         forms say when the level was read (the last placeholder: a date and time) when it is not live. -->
    <string name="dashboard_overview_not_reported" volt:screen="Home battery overview widget" volt:purpose="accessibility description" volt:safety="charge">Battery not reported</string>
    <string name="dashboard_overview_not_reported_seen" volt:screen="Home battery overview widget" volt:purpose="accessibility description" volt:safety="charge">Battery not reported, last seen %1$s</string>
    <string name="dashboard_overview_not_reported_line" volt:screen="Home battery overview widget" volt:purpose="accessibility description" volt:safety="charge">Battery not reported, %1$s</string>
    <string name="dashboard_overview_not_reported_line_seen" volt:screen="Home battery overview widget" volt:purpose="accessibility description" volt:safety="charge">Battery not reported, %1$s, last seen %2$s</string>
    <string name="dashboard_overview_percent" volt:screen="Home battery overview widget" volt:purpose="accessibility description" volt:safety="charge">Battery %1$s percent</string>
    <string name="dashboard_overview_percent_seen" volt:screen="Home battery overview widget" volt:purpose="accessibility description" volt:safety="charge">Battery %1$s percent, last seen %2$s</string>
    <string name="dashboard_overview_percent_line" volt:screen="Home battery overview widget" volt:purpose="accessibility description" volt:safety="charge">Battery %1$s percent, %2$s</string>
    <string name="dashboard_overview_percent_line_seen" volt:screen="Home battery overview widget" volt:purpose="accessibility description" volt:safety="charge">Battery %1$s percent, %2$s, last seen %3$s</string>
    <!-- Widget bodies -->
    <!-- Spoken for a reading on a card: %1$s is the reading's name, %2$s its value with unit; the
         _seen form adds when it was read (%3$s: a date and time) when it is not live. -->
    <string name="dashboard_reading" volt:screen="Home cards" volt:purpose="accessibility description">%1$s, %2$s</string>
    <string name="dashboard_reading_seen" volt:screen="Home cards" volt:purpose="accessibility description">%1$s, %2$s, last seen %3$s</string>
    <!-- Spoken for the drive mode card: %1$s is the mode's name as the scooter reports it; the _seen
         form adds when it was read (%2$s: a date and time). -->
    <string name="dashboard_drive_mode_reading" volt:screen="Home drive mode card" volt:purpose="accessibility description">Drive mode, %1$s</string>
    <string name="dashboard_drive_mode_reading_seen" volt:screen="Home drive mode card" volt:purpose="accessibility description">Drive mode, %1$s, last seen %2$s</string>
    <!-- The battery health card: %1$s is how many charges the scooter reports (a number). -->
    <string name="dashboard_reported_charges" volt:screen="Home battery health widget" volt:purpose="value">%1$s reported charges</string>
    <!-- The battery health card: %1$s is the pack's rated capacity with unit ("15.0 Ah"). -->
    <string name="dashboard_rated" volt:screen="Home battery health widget" volt:purpose="value">%1$s rated</string>
    <!-- A card's age footer, spoken and as a tooltip: %1$s is a date and time. -->
    <string name="dashboard_last_seen" volt:screen="Home cards" volt:purpose="tooltip">Last seen %1$s</string>
    <!-- The ride recorder's title while recording: %1$s is the elapsed time ("4:05" or "1:04:05"). -->
    <string name="dashboard_recording_clock" volt:screen="Home ride recorder widget" volt:purpose="title">Recording · %1$s</string>
    <!-- The ride recorder's detail before distance or energy is known. -->
    <string name="dashboard_measuring" volt:screen="Home ride recorder widget" volt:purpose="status">Measuring…</string>
    <string name="dashboard_saving_ride" volt:screen="Home ride recorder widget" volt:purpose="status">Saving the last ride…</string>
    <string name="dashboard_connecting" volt:screen="Home ride recorder widget" volt:purpose="status">Connecting…</string>
    <!-- Spoken for the recorder's button when not recording. -->
    <string name="dashboard_record_saving" volt:screen="Home ride recorder widget" volt:purpose="accessibility description">Record ride. Saving the last ride</string>
    <string name="dashboard_start_recording" volt:screen="Home ride recorder widget" volt:purpose="accessibility description">Start recording</string>
    <string name="dashboard_record_connecting" volt:screen="Home ride recorder widget" volt:purpose="accessibility description">Record ride. Connecting</string>
    <string name="dashboard_record_connect" volt:screen="Home ride recorder widget" volt:purpose="accessibility description">Record ride. Connect to scooter</string>
    <!-- The usable ride energy (capacity) widget and its details sheet -->
    <!-- An estimated energy: %1$s is a number, %2$s the unit symbol ("Wh"). -->
    <string name="dashboard_approx_energy" volt:screen="Home capacity widget" volt:purpose="value" volt:safety="experimental">≈ %1$s %2$s</string>
    <!-- Marks the sample-data preview. -->
    <string name="dashboard_sample" volt:screen="Home capacity widget" volt:purpose="label" volt:safety="experimental">Sample</string>
    <!-- The sample preview's summary: %1$s and %2$s are the low and high energy, %3$s the unit ("Wh"). -->
    <string name="dashboard_sample_rides" volt:screen="Home capacity widget" volt:purpose="value" volt:safety="experimental">8 rides · %1$s–%2$s %3$s</string>
    <string name="dashboard_no_scooter" volt:screen="Home capacity widget" volt:purpose="status" volt:safety="experimental">No scooter set up</string>
    <string name="dashboard_updating_rides" volt:screen="Home capacity widget" volt:purpose="status" volt:safety="experimental">Updating recorded rides…</string>
    <string name="dashboard_refresh_unavailable" volt:screen="Home capacity widget" volt:purpose="status" volt:safety="experimental">Last estimate · refresh unavailable</string>
    <string name="dashboard_estimate_unavailable" volt:screen="Home capacity widget" volt:purpose="status" volt:safety="experimental">Estimate unavailable</string>
    <string name="dashboard_not_enough_data" volt:screen="Home capacity widget" volt:purpose="value" volt:safety="experimental">Not enough ride data</string>
    <!-- The summary: %1$s is how many rides were used (English keeps "rides" for every number), %2$s and %3$s the low and high energy, %4$s the unit ("Wh"). -->
    <string name="dashboard_rides_range" volt:screen="Home capacity widget" volt:purpose="value" volt:safety="experimental">%1$s rides · %2$s–%3$s %4$s</string>
    <!-- The summary without a range: %1$s rides, %2$s battery percentage points. -->
    <string name="dashboard_rides_points" volt:screen="Home capacity widget" volt:purpose="value" volt:safety="experimental">%1$s rides · %2$s points used</string>
    <!-- How the estimate compares with the reference: %1$s is a whole percent, %2$s the reference energy, %3$s the unit ("Wh"). -->
    <string name="dashboard_percent_of" volt:screen="Home capacity widget" volt:purpose="value" volt:safety="experimental">%1$s%% of %2$s %3$s</string>
    <!-- Detail row names in the estimate details sheet. -->
    <string name="dashboard_rides" volt:screen="Home capacity widget" volt:purpose="label" volt:safety="experimental">Rides</string>
    <string name="dashboard_points" volt:screen="Home capacity widget" volt:purpose="label" volt:safety="experimental">Points</string>
    <string name="dashboard_window" volt:screen="Home capacity widget" volt:purpose="label" volt:safety="experimental">Window</string>
    <string name="dashboard_rides_needed" volt:screen="Home capacity widget" volt:purpose="label" volt:safety="experimental">Rides needed</string>
    <string name="dashboard_range_90" volt:screen="Home capacity widget" volt:purpose="label" volt:safety="experimental" formatted="false">90% range</string>
