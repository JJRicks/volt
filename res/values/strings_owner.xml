<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner setup and Shizuku (batch B6): the phone-only setup screen (ShizukuSetupActivity), the capture
  client's status lines (ShizukuCaptureClient), the setup file refusals (OwnerIdentityParser,
  ScooterProfiles) and the default scooter name. The English must stay exactly what the source said
  before the batch (G1, G2).

  Safety: this screen captures the scooter's owner key from NAVEE's log with broad debugging access.
  Never soften a privacy warning ("broad debugging access", "Nothing uploaded", "may still be on"),
  never turn "not yet" or "unconfirmed" into done, and keep owner and shared user distinct.
  The status lines and refusals stay English in the code (tests, logs and the Shizuku shell process
  read them); the screens show these keys in their place.
-->
<resources xmlns:volt="https://volt.jjricks.com/ns/l10n"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- The setup screen's title, on every step. -->
    <string name="owner_shizuku_title" volt:screen="Phone-only setup" volt:purpose="title"
        volt:safety="owner-key">Phone-only setup</string>
    <!-- Shown when Volt runs in a work or secondary Android profile, where capture cannot work. -->
    <string name="owner_shizuku_main_profile_only" volt:screen="Phone-only setup" volt:purpose="message"
        volt:dnt="Android">Main Android profile only.</string>
    <!-- Button: leave this screen and import a private setup backup file instead. -->
    <string name="owner_shizuku_import_backup" volt:screen="Phone-only setup" volt:purpose="button"
        volt:safety="owner-key">Import backup</string>
    <!-- Button on most steps: close this screen and go back to the list of setup methods. -->
    <string name="owner_shizuku_back_to_choices" volt:screen="Phone-only setup" volt:purpose="button">Back to setup choices</string>
    <!-- Shown on Android 10 and older, where this setup is not offered. -->
    <string name="owner_shizuku_needs_android_11" volt:screen="Phone-only setup" volt:purpose="message"
        volt:dnt="Android">Needs Android 11 or newer.</string>

    <!-- Title while the capture waits for the owner to connect to the scooter in NAVEE's app. -->
    <string name="owner_shizuku_connecting_title" volt:screen="Phone-only setup, capturing" volt:purpose="title"
        volt:safety="owner-key" volt:dnt="NAVEE">Connect your scooter in NAVEE</string>
    <!-- Title while Volt turns NAVEE's app logging back off after a capture. -->
    <string name="owner_shizuku_restoring_title" volt:screen="Phone-only setup, capturing" volt:purpose="title"
        volt:safety="privacy" volt:dnt="NAVEE">Restoring NAVEE logging…</string>
    <!-- Title while the capture is being prepared. -->
    <string name="owner_shizuku_preparing_title" volt:screen="Phone-only setup, capturing" volt:purpose="title">Preparing capture…</string>
    <!-- Under the countdown: open NAVEE's app, connect to the scooter there, then come back to Volt. -->
    <string name="owner_shizuku_connecting_hint" volt:screen="Phone-only setup, capturing" volt:purpose="instruction"
        volt:dnt="NAVEE">Connect in NAVEE, then return.</string>
    <!-- While preparing or cleaning up: Shizuku must keep running, or NAVEE's logging cannot be turned off. -->
    <string name="owner_shizuku_keep_running" volt:screen="Phone-only setup, capturing" volt:purpose="instruction"
        volt:safety="privacy" volt:dnt="Shizuku">Keep Shizuku running.</string>
    <!-- Button: stop the capture; Volt then restores NAVEE's logging. -->
    <string name="owner_shizuku_cancel_capture" volt:screen="Phone-only setup, capturing" volt:purpose="button">Cancel capture</string>
    <!-- Spoken description of the 90-second countdown ring: %1$d is the whole seconds left (90 to 0). -->
    <plurals name="owner_countdown_seconds_left" volt:screen="Phone-only setup, capturing"
        volt:purpose="accessibility description">
        <item quantity="one">%1$d second left</item>
        <item quantity="other">%1$d seconds left</item>
    </plurals>
    <!-- Drawn in small type under the big number of seconds inside the 132dp countdown ring; "s" is the
         seconds symbol. The text must fit inside the ring (about 102dp at that height). -->
    <string name="owner_countdown_seconds_left_short" volt:screen="Phone-only setup, capturing" volt:purpose="label"
        volt:ladder="short" volt:max="102dp@12.5sp">s left</string>

    <!-- Dialog title when the person presses Back during a capture. -->
    <string name="owner_shizuku_stop_title" volt:screen="Phone-only setup, stop dialog" volt:purpose="title">Stop setup?</string>
    <!-- Dialog message: leaving now would leave NAVEE's logging on until Volt restores it. -->
    <string name="owner_shizuku_stop_message" volt:screen="Phone-only setup, stop dialog" volt:purpose="message"
        volt:safety="privacy" volt:dnt="NAVEE">Wait here until NAVEE is restored.</string>
    <!-- Dialog button: keep the capture running and stay on this screen. -->
    <string name="owner_shizuku_keep_waiting" volt:screen="Phone-only setup, stop dialog" volt:purpose="button">Keep waiting</string>
    <!-- Dialog button: stop the capture (Volt then restores NAVEE's logging). -->
    <string name="owner_shizuku_stop" volt:screen="Phone-only setup, stop dialog" volt:purpose="button">Stop setup</string>

    <!-- Title when an earlier capture may have left NAVEE's logging on. -->
    <string name="owner_shizuku_cleanup_title" volt:screen="Phone-only setup, cleanup" volt:purpose="title"
        volt:safety="privacy">Finish cleanup first</string>
    <!-- Warning: NAVEE's app logging, turned on for an earlier capture, may not have been turned off. -->
    <string name="owner_shizuku_cleanup_message" volt:screen="Phone-only setup, cleanup" volt:purpose="warning"
        volt:safety="privacy" volt:dnt="NAVEE">NAVEE logging may still be on.</string>
    <!-- Button: turn NAVEE's logging back off. -->
    <string name="owner_shizuku_restore_logging" volt:screen="Phone-only setup, cleanup" volt:purpose="button"
        volt:safety="privacy" volt:dnt="NAVEE">Restore NAVEE logging</string>
    <!-- Button on the cleanup screen: close this screen. -->
    <string name="owner_shizuku_back" volt:screen="Phone-only setup, cleanup" volt:purpose="button">Back</string>

    <!-- Title once a capture found the scooter's identity, before anything is saved. -->
    <string name="owner_shizuku_ready_title" volt:screen="Phone-only setup, ready" volt:purpose="title"
        volt:safety="owner-key">Ready to import</string>
    <!-- Checklist row: the capture found a shared user's identity (access the owner granted another
         account), not the owner's. Keep shared user and owner distinct. -->
    <string name="owner_shizuku_shared_identity_found" volt:screen="Phone-only setup, ready" volt:purpose="status"
        volt:safety="owner-key">Shared-user identity found</string>
    <!-- Checklist row: the capture found the scooter owner's identity. -->
    <string name="owner_shizuku_owner_identity_found" volt:screen="Phone-only setup, ready" volt:purpose="status"
        volt:safety="owner-key">Owner identity found</string>
    <!-- Checklist row: NAVEE's app logging is turned back off. -->
    <string name="owner_shizuku_navee_restored" volt:screen="Phone-only setup, ready" volt:purpose="status"
        volt:safety="privacy" volt:dnt="NAVEE">NAVEE restored</string>
    <!-- Button: save the captured identity as this scooter's owner setup. -->
    <string name="owner_shizuku_import_owner_setup" volt:screen="Phone-only setup, ready" volt:purpose="button"
        volt:safety="owner-key">Import owner setup</string>
    <!-- Button: throw the captured identity away without saving it. -->
    <string name="owner_shizuku_discard" volt:screen="Phone-only setup, ready" volt:purpose="button"
        volt:safety="owner-key">Discard</string>

    <!-- Step 1 title: Shizuku must be installed and running. -->
    <string name="owner_shizuku_start_title" volt:screen="Phone-only setup, step 1" volt:purpose="title"
        volt:dnt="Shizuku">Start Shizuku</string>
    <!-- Checklist row: the Shizuku app is installed. Followed by ", done" or ", not yet" when spoken. -->
    <string name="owner_shizuku_installed" volt:screen="Phone-only setup, step 1" volt:purpose="label"
        volt:dnt="Shizuku">Shizuku installed</string>
    <!-- Small button in the "Shizuku installed" row: open Shizuku's download page. -->
    <string name="owner_shizuku_install" volt:screen="Phone-only setup, step 1" volt:purpose="button"
        volt:max="48dp@14sp">Install</string>
    <!-- Checklist row: Shizuku's service is running. Followed by ", done" or ", not yet" when spoken. -->
    <string name="owner_shizuku_running" volt:screen="Phone-only setup, step 1" volt:purpose="label"
        volt:dnt="Shizuku">Shizuku running</string>
    <!-- Small button in the "Shizuku running" row: open the Shizuku app. -->
    <string name="owner_shizuku_open" volt:screen="Phone-only setup, step 1" volt:purpose="button"
        volt:max="48dp@14sp">Open</string>
    <!-- Button: open Shizuku's setup guide in the browser. -->
    <string name="owner_shizuku_setup_guide" volt:screen="Phone-only setup" volt:purpose="button"
        volt:dnt="Shizuku">Shizuku setup guide</string>
    <!-- Button on the cleanup screen: open Shizuku's download page. -->
    <string name="owner_shizuku_install_shizuku" volt:screen="Phone-only setup, cleanup" volt:purpose="button"
        volt:dnt="Shizuku">Install Shizuku</string>
    <!-- Button: open the Shizuku app. -->
    <string name="owner_shizuku_open_shizuku" volt:screen="Phone-only setup" volt:purpose="button"
        volt:dnt="Shizuku">Open Shizuku</string>

    <!-- Step 2 title: Shizuku must let Volt use it. -->
    <string name="owner_shizuku_allow_title" volt:screen="Phone-only setup, step 2" volt:purpose="title"
        volt:safety="privacy">Allow temporary access</string>
    <!-- Warning before granting access: Shizuku access is broad debugging access to the phone; Volt uses
         it only on this screen and uploads nothing. Do not soften "broad". -->
    <string name="owner_shizuku_allow_warning" volt:screen="Phone-only setup, step 2" volt:purpose="warning"
        volt:safety="privacy">Grants broad debugging access. Used only here. Nothing uploaded.</string>
    <!-- Spoken description of "Open Shizuku" when Volt must be allowed inside the Shizuku app. -->
    <string name="owner_shizuku_open_shizuku_description" volt:screen="Phone-only setup, step 2"
        volt:purpose="accessibility description" volt:dnt="Shizuku|Volt">Open Shizuku to allow Volt</string>
    <!-- Button: open Shizuku's setup help in the browser. -->
    <string name="owner_shizuku_help" volt:screen="Phone-only setup, step 2" volt:purpose="button"
        volt:dnt="Shizuku">Shizuku help</string>
    <!-- Button: ask Shizuku for access. -->
    <string name="owner_shizuku_allow_access" volt:screen="Phone-only setup, step 2" volt:purpose="button"
        volt:safety="privacy" volt:dnt="Shizuku">Allow Shizuku access</string>
    <!-- Spoken description of "Allow Shizuku access": the access is broad, and asking for it does not
         start a capture. -->
    <string name="owner_shizuku_allow_access_description" volt:screen="Phone-only setup, step 2"
        volt:purpose="accessibility description" volt:safety="privacy"
        volt:dnt="Shizuku">Request broad debugging access from Shizuku; does not start capture</string>
    <!-- Button when Shizuku does not answer: check again whether it is running. -->
    <string name="owner_shizuku_check_connection" volt:screen="Phone-only setup" volt:purpose="button"
        volt:dnt="Shizuku">Check Shizuku connection</string>
    <!-- Spoken description of "Check Shizuku connection". -->
    <string name="owner_shizuku_check_connection_description" volt:screen="Phone-only setup"
        volt:purpose="accessibility description" volt:dnt="Shizuku">Check whether Shizuku is running</string>

    <!-- Step 3 title: capture the identity from the person's own scooter. -->
    <string name="owner_shizuku_capture_title" volt:screen="Phone-only setup, step 3" volt:purpose="title"
        volt:safety="owner-key">Capture from your scooter</string>
    <!-- Step 3 instruction: the scooter should be parked and connected in NAVEE's app before the capture. -->
    <string name="owner_shizuku_capture_parked" volt:screen="Phone-only setup, step 3" volt:purpose="instruction"
        volt:dnt="NAVEE">Connect to your parked scooter in NAVEE first.</string>
    <!-- Step 3 warning: what the capture does to NAVEE's app, and that Shizuku must keep running until
         Volt has turned the logging back off. -->
    <string name="owner_shizuku_capture_warning" volt:screen="Phone-only setup, step 3" volt:purpose="warning"
        volt:safety="privacy" volt:dnt="NAVEE|Shizuku">Capture restarts NAVEE and temporarily enables logging. Keep Shizuku running until cleanup finishes.</string>
    <!-- Check box the person must tick before the capture starts. -->
    <string name="owner_shizuku_consent" volt:screen="Phone-only setup, step 3" volt:purpose="check box"
        volt:safety="owner-key">I own this scooter or have permission.</string>
    <!-- Button: start the capture (only after the check box is ticked). -->
    <string name="owner_shizuku_start_capture" volt:screen="Phone-only setup, step 3" volt:purpose="button"
        volt:safety="owner-key">Start capture</string>

    <!-- Spoken for a finished checklist row: %1$s is the row's label ("Shizuku installed"). -->
    <string name="owner_step_done" volt:screen="Phone-only setup" volt:purpose="accessibility description">%1$s, done</string>
    <!-- Spoken for an unfinished checklist row: %1$s is the row's label ("Shizuku running"). -->
    <string name="owner_step_not_yet" volt:screen="Phone-only setup" volt:purpose="accessibility description">%1$s, not yet</string>
    <!-- Spoken for an unfinished checklist row with the reason under it: %1$s is the row's label, %2$s
         the reason (a status line such as "Update Shizuku"). -->
    <string name="owner_step_not_yet_problem" volt:screen="Phone-only setup" volt:purpose="accessibility description">%1$s, not yet. %2$s</string>
    <!-- Spoken description of the three-segment progress bar: %1$d is the current step, 1 to 3. -->
    <string name="owner_steps_description" volt:screen="Phone-only setup" volt:purpose="accessibility description">Step %1$d of 3</string>

    <!-- Status lines of the capture client, shown in bold under the step's title. -->
    <!-- Shizuku refused Volt's request for access. -->
    <string name="owner_status_access_denied" volt:screen="Phone-only setup" volt:purpose="status">Access denied</string>
    <!-- Shizuku's service does not answer. -->
    <string name="owner_status_not_running" volt:screen="Phone-only setup" volt:purpose="status"
        volt:dnt="Shizuku">Shizuku isn\'t running</string>
    <!-- The installed Shizuku is too old. -->
    <string name="owner_status_update_shizuku" volt:screen="Phone-only setup" volt:purpose="status"
        volt:dnt="Shizuku">Update Shizuku</string>
    <!-- Shizuku runs as root, which Volt refuses; it must be started with Android's wireless debugging. -->
    <string name="owner_status_root_unsupported" volt:screen="Phone-only setup" volt:purpose="status"
        volt:dnt="Shizuku">Root Shizuku isn\'t supported. Start it with wireless debugging.</string>
    <!-- Android will not show Shizuku's prompt again: Volt has to be allowed inside the Shizuku app. -->
    <string name="owner_status_allow_in_shizuku" volt:screen="Phone-only setup" volt:purpose="status"
        volt:dnt="Volt|Shizuku">Allow Volt in Shizuku</string>
    <!-- Shizuku stopped answering. -->
    <string name="owner_status_shizuku_stopped" volt:screen="Phone-only setup" volt:purpose="status"
        volt:dnt="Shizuku">Shizuku stopped</string>
    <!-- Volt cannot tell what an earlier capture left behind; NAVEE's logging must be restored from a
         computer (the setup guide explains how). -->
    <string name="owner_status_cleanup_unknown" volt:screen="Phone-only setup, cleanup" volt:purpose="status"
        volt:safety="privacy">Cleanup unknown. Use computer recovery.</string>
    <!-- The capture could not start; nothing on the phone was changed. -->
    <string name="owner_status_start_failed" volt:screen="Phone-only setup" volt:purpose="status">Couldn\'t start. Nothing changed.</string>
    <!-- Volt's helper inside Shizuku did not start. -->
    <string name="owner_status_helper_not_started" volt:screen="Phone-only setup" volt:purpose="status">Helper didn\'t start</string>
    <!-- Volt could not confirm that NAVEE's logging was turned back off. Never say it was. -->
    <string name="owner_status_cleanup_unconfirmed" volt:screen="Phone-only setup" volt:purpose="status"
        volt:safety="privacy">Logging cleanup unconfirmed</string>
    <!-- The 90-second capture ended without finding the identity; "s" is the seconds symbol. -->
    <string name="owner_status_nothing_found" volt:screen="Phone-only setup" volt:purpose="status">Nothing found in 90 s</string>
    <!-- The capture saw more than one scooter's identity; connect to only one in NAVEE's app. -->
    <string name="owner_status_several_scooters" volt:screen="Phone-only setup" volt:purpose="status"
        volt:safety="owner-key">Several scooters. Connect one.</string>
    <!-- Another capture already runs in Shizuku. -->
    <string name="owner_status_capture_busy" volt:screen="Phone-only setup" volt:purpose="status">Another capture is running</string>
    <!-- Android refused to let Volt read NAVEE's app log. -->
    <string name="owner_status_log_unreadable" volt:screen="Phone-only setup" volt:purpose="status"
        volt:dnt="Volt|NAVEE">Volt couldn\'t read NAVEE\'s log</string>
    <!-- The capture was stopped. -->
    <string name="owner_status_stopped" volt:screen="Phone-only setup" volt:purpose="status">Stopped</string>
    <!-- The capture failed. -->
    <string name="owner_status_capture_failed" volt:screen="Phone-only setup" volt:purpose="status">Capture failed</string>
    <!-- Volt could not record that NAVEE's logging was restored; restore it again. -->
    <string name="owner_status_restore_again" volt:screen="Phone-only setup" volt:purpose="status"
        volt:safety="privacy">Restore logging again</string>
    <!-- Volt is turning NAVEE's logging back off after a stopped capture. -->
    <string name="owner_status_restoring" volt:screen="Phone-only setup" volt:purpose="status"
        volt:safety="privacy" volt:dnt="NAVEE">Restoring NAVEE…</string>
    <!-- Shizuku stopped while NAVEE's logging may still be on; it must be restored. -->
    <string name="owner_status_lost" volt:screen="Phone-only setup" volt:purpose="status"
        volt:safety="privacy" volt:dnt="Shizuku">Shizuku lost. Restore logging.</string>
    <!-- No browser on the phone could open Shizuku's web page. -->
    <string name="owner_status_no_browser" volt:screen="Phone-only setup" volt:purpose="status">No browser found</string>

    <!-- Why a setup file or typed identity was refused (shown by the setup screens that import one). -->
    <!-- The file is empty or larger than 1 MB. -->
    <string name="owner_setup_empty_or_large" volt:screen="Owner setup import" volt:purpose="error"
        volt:safety="owner-key">Setup file is empty or too large.</string>
    <!-- An identity field is not 12 hexadecimal characters. -->
    <string name="owner_setup_need_hex" volt:screen="Owner setup import" volt:purpose="error"
        volt:safety="owner-key">Need 12 hex characters</string>
    <!-- The file holds no owner identity Volt can use. -->
    <string name="owner_setup_no_identity" volt:screen="Owner setup import" volt:purpose="error"
        volt:safety="owner-key">No owner identity in file</string>
    <!-- The file names a role other than owner or shared user. -->
    <string name="owner_setup_unsupported_role" volt:screen="Owner setup import" volt:purpose="error"
        volt:safety="owner-key">Unsupported owner role</string>
    <!-- The file holds more than one identity or role, so Volt imports none of them. -->
    <string name="owner_setup_conflicting" volt:screen="Owner setup import" volt:purpose="error"
        volt:safety="owner-key" volt:dnt="NAVEE">This file contains conflicting owner identities or roles. Capture one NAVEE account connection or import one private setup backup.</string>
    <!-- A staged import request was damaged; pick the setup file again. -->
    <string name="owner_setup_import_failed" volt:screen="Owner setup import" volt:purpose="error"
        volt:safety="owner-key">Import failed. Pick file again.</string>
    <!-- The typed owner identity is not 12 hexadecimal characters, or its role is not owner or shared user. -->
    <string name="owner_setup_enter_identity" volt:screen="Owner setup import" volt:purpose="error"
        volt:safety="owner-key">Enter a 12-character owner identity.</string>

    <!-- The name Volt gives a new scooter profile when the person typed none. It is saved in English and
         shown in the phone's language until the person renames the scooter. -->
    <string name="owner_profile_default_name" volt:screen="My scooters" volt:purpose="name">Scooter</string>
</resources>
