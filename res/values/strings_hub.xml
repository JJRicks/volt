<?xml version="1.0" encoding="utf-8"?>
<!--
  The Hub (hub layout plan, PR 2): Home lists the scooter's subjects (Ride, Battery & charging,
  Controls, Lights & sound, Security, Service, Data), each with a one-line live summary, and each
  subject opens its own page. Longer subjects split into sub-pages, opened from link rows on the
  subject's page. A sub-page shows a back link to the page above it.

  Subject names are page titles and Home's row names; the _short rung is for narrow places such as
  icon captions. Summaries are whole lines; values arrive formatted with their unit ("6.2 mi",
  "90%"), dates arrive formatted for the language. A summary that cannot be known is not shown.
-->
<resources xmlns:volt="https://volt.jjricks.com/ns/l10n"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ===== Subjects: Home's rows and their pages' titles ===== -->
    <!-- Rides: recording, the ride list and riding mode. -->
    <string name="hub_subject_ride" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="full">Ride</string>
    <string name="hub_subject_ride_short" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="short" volt:max="64dp@12sp">Ride</string>
    <!-- Battery level, charge limit, charging schedule and charge history. -->
    <string name="hub_subject_battery" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="full">Battery &amp; charging</string>
    <string name="hub_subject_battery_short" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="short" volt:max="64dp@12sp">Battery</string>
    <!-- Drive modes, cruise control, assists and speed limits. -->
    <string name="hub_subject_controls" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="full">Controls</string>
    <string name="hub_subject_controls_short" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="short" volt:max="64dp@12sp">Controls</string>
    <!-- The scooter's lights and sounds. -->
    <string name="hub_subject_lights" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="full">Lights &amp; sound</string>
    <string name="hub_subject_lights_short" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="short" volt:max="64dp@12sp">Lights</string>
    <!-- Lock, PIN and proximity unlock. -->
    <string name="hub_subject_security" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="full">Security</string>
    <string name="hub_subject_security_short" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="short" volt:max="64dp@12sp">Security</string>
    <!-- Maintenance reminders, experimental controls, compatibility tests and issue reports. -->
    <string name="hub_subject_service" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="full">Service</string>
    <string name="hub_subject_service_short" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="short" volt:max="64dp@12sp">Service</string>
    <!-- Live readings, charts, diagnostics and stored history. -->
    <string name="hub_subject_data" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="full">Data</string>
    <string name="hub_subject_data_short" volt:screen="Home subjects, dock, page titles" volt:purpose="title" volt:ladder="short" volt:max="64dp@12sp">Data</string>

    <!-- ===== Sub-pages: the link row on the subject's page, and the sub-page's title ===== -->
    <!-- The full list of saved rides, where two rides can be compared. -->
    <string name="hub_page_ride_rides" volt:screen="Ride page" volt:purpose="row and page title">All rides &amp; compare</string>
    <!-- Automatic recording, auto end, keeping the screen awake and the phone's sensors. -->
    <string name="hub_page_ride_recording" volt:screen="Ride page" volt:purpose="row and page title">Recording settings</string>
    <!-- Settings of riding mode, the full-screen display used while riding. -->
    <string name="hub_page_ride_riding" volt:screen="Ride page" volt:purpose="row and page title">Riding mode</string>
    <!-- Button that opens riding mode now. -->
    <string name="hub_ride_open_riding" volt:screen="Ride page" volt:purpose="button">Open riding mode</string>
    <!-- Label above the last few rides. -->
    <string name="hub_ride_recent" volt:screen="Ride page" volt:purpose="section label">Recent rides</string>

    <!-- Low Battery Mode and Long range mode. -->
    <string name="hub_page_battery_modes" volt:screen="Battery &amp; charging page" volt:purpose="row and page title" volt:safety="charge">Battery modes</string>
    <!-- Settings made once: the charger used for time estimates, the range estimate's source, the scheduled-charging test and usable ride energy. -->
    <string name="hub_page_battery_estimates" volt:screen="Battery &amp; charging page" volt:purpose="row and page title" volt:safety="charge">Estimates &amp; charger</string>
    <!-- Past charging sessions, and recordings of a charge's curve. -->
    <string name="hub_page_battery_history" volt:screen="Battery &amp; charging page" volt:purpose="row and page title">Charge history &amp; recordings</string>

    <!-- The scooter's assists: Walk Assist, Power Assist, hill descent control and kick-start speed. -->
    <string name="hub_page_controls_assists" volt:screen="Controls page" volt:purpose="row and page title">Assists</string>
    <!-- Limits set once: a custom speed limit, a speed limit per drive mode, and overspeed control. -->
    <string name="hub_page_controls_limits" volt:screen="Controls page" volt:purpose="row and page title">Speed limits</string>

    <!-- The scooter's light strips along the deck: their pattern and colour. -->
    <string name="hub_page_lights_line" volt:screen="Lights &amp; sound page" volt:purpose="row and page title">Line lights</string>
    <!-- The scooter's small decorative lights: their pattern and colour. -->
    <string name="hub_page_lights_star" volt:screen="Lights &amp; sound page" volt:purpose="row and page title">Star lights</string>

    <!-- Controls the official app may not offer on this model, to try with care. -->
    <string name="hub_page_service_experimental" volt:screen="Service page" volt:purpose="row and page title" volt:safety="experimental">Experimental controls</string>
    <!-- A guided test of which commands this scooter understands. -->
    <string name="hub_page_service_compatibility" volt:screen="Service page" volt:purpose="row and page title">Compatibility test</string>
    <!-- Row that opens the Diagnostics section of the Data page: connection events and command logs. -->
    <string name="hub_page_service_diagnostics" volt:screen="Service page" volt:purpose="row title">Diagnostics &amp; connection activity</string>
    <!-- Drafting an email to Volt about a problem, with an optional report attached. -->
    <string name="hub_page_service_reports" volt:screen="Service page" volt:purpose="row and page title">Issue reports</string>

    <!-- Ride and telemetry history stored on the phone, and how much is kept. -->
    <string name="hub_page_data_storage" volt:screen="Data page" volt:purpose="row and page title">Data &amp; history</string>

    <!-- ===== Settings ===== -->
    <!-- The app's own settings (units, scooters, about), opened from the gear in Home's header. Also the back link's target name on its sub-pages. -->
    <string name="hub_page_settings" volt:screen="Settings page" volt:purpose="title">Settings</string>

    <!-- ===== Page header and rows ===== -->
    <!-- Screen-reader label of a sub-page's back link. %1$s is the name of the page it returns to ("Battery & charging"). -->
    <string name="hub_back_to" volt:screen="Page header back link" volt:purpose="accessibility">Back to %1$s</string>
    <!-- Small label on a subject page's row for a control that is still experimental on this model. -->
    <string name="hub_experimental_badge" volt:screen="Subject page rows" volt:purpose="badge" volt:safety="experimental">Experimental</string>
    <!-- Screen-reader text of such a row. %1$s is the control's name. Tapping the row opens that control's test in Service › Experimental controls. -->
    <string name="hub_experimental_row_description" volt:screen="Subject page rows" volt:purpose="accessibility" volt:safety="experimental">%1$s, experimental. Opens its test in Experimental controls.</string>

    <!-- ===== Home: one-line summaries under each subject ===== -->
    <!-- %1$s is the last ride's distance with its unit ("6.2 mi"). -->
    <string name="hub_summary_ride_last_today" volt:screen="Home subject summaries" volt:purpose="summary">Last ride %1$s · today</string>
    <!-- %1$s is the last ride's distance with its unit. -->
    <string name="hub_summary_ride_last_yesterday" volt:screen="Home subject summaries" volt:purpose="summary">Last ride %1$s · yesterday</string>
    <!-- %1$s is the last ride's distance with its unit, %2$s the day it ended, formatted for the language. -->
    <string name="hub_summary_ride_last_date" volt:screen="Home subject summaries" volt:purpose="summary">Last ride %1$s · %2$s</string>
    <!-- A ride is being recorded now. %1$s is the time recorded so far ("12:40"). -->
    <string name="hub_summary_ride_recording" volt:screen="Home subject summaries" volt:purpose="summary" volt:safety="ride">Recording · %1$s</string>
    <string name="hub_summary_ride_none" volt:screen="Home subject summaries" volt:purpose="summary">No rides yet</string>
    <!-- %1$s is the charge limit as a percent ("90%"). -->
    <string name="hub_summary_battery_limit_idle" volt:screen="Home subject summaries" volt:purpose="summary" volt:safety="charge">Limit %1$s · not charging</string>
    <!-- %1$s is the charge limit as a percent. -->
    <string name="hub_summary_battery_limit_charging" volt:screen="Home subject summaries" volt:purpose="summary" volt:safety="charge">Charging · limit %1$s</string>
    <!-- For a model with no charge limit. %1$s is the battery level as a percent. -->
    <string name="hub_summary_battery_idle" volt:screen="Home subject summaries" volt:purpose="summary" volt:safety="charge">%1$s · not charging</string>
    <!-- For a model with no charge limit. %1$s is the battery level as a percent. -->
    <string name="hub_summary_battery_charging" volt:screen="Home subject summaries" volt:purpose="summary" volt:safety="charge">Charging · %1$s</string>
    <!-- %1$s is the drive mode as Home shows it, with its top speed ("Sport 31 mph"). -->
    <string name="hub_summary_controls_cruise_on" volt:screen="Home subject summaries" volt:purpose="summary">%1$s · cruise on</string>
    <!-- %1$s is the drive mode as Home shows it, with its top speed. -->
    <string name="hub_summary_controls_cruise_off" volt:screen="Home subject summaries" volt:purpose="summary">%1$s · cruise off</string>
    <!-- The Automatic lights setting is on. Use the same words as the Automatic lights row. -->
    <string name="hub_summary_lights_automatic" volt:screen="Home subject summaries" volt:purpose="summary">Automatic lights</string>
    <!-- The Tail light setting. Use the same words for "Tail light" as the Tail light row. -->
    <string name="hub_summary_lights_tail_on" volt:screen="Home subject summaries" volt:purpose="summary">Tail light on</string>
    <string name="hub_summary_lights_tail_off" volt:screen="Home subject summaries" volt:purpose="summary">Tail light off</string>
    <!-- The handlebar PIN, and unlocking when the owner's phone comes near. -->
    <string name="hub_summary_security_pin_on_proximity_on" volt:screen="Home subject summaries" volt:purpose="summary" volt:safety="pin,owner-key">PIN on · proximity on</string>
    <string name="hub_summary_security_pin_on_proximity_off" volt:screen="Home subject summaries" volt:purpose="summary" volt:safety="pin,owner-key">PIN on · proximity off</string>
    <string name="hub_summary_security_pin_off_proximity_on" volt:screen="Home subject summaries" volt:purpose="summary" volt:safety="pin,owner-key">PIN off · proximity on</string>
    <string name="hub_summary_security_pin_off_proximity_off" volt:screen="Home subject summaries" volt:purpose="summary" volt:safety="pin,owner-key">PIN off · proximity off</string>
    <!-- The next maintenance check. %1$s is the reminder's name ("Tire pressure"), %2$s when it is due ("40 mi left", "Due today"). -->
    <string name="hub_summary_service_due" volt:screen="Home subject summaries" volt:purpose="summary">%1$s: %2$s</string>
    <string name="hub_summary_service_clear" volt:screen="Home subject summaries" volt:purpose="summary">No checks due</string>
    <string name="hub_summary_data" volt:screen="Home subject summaries" volt:purpose="summary">Live readings, charts</string>

    <!-- ===== Battery & charging › Charge history & recordings ===== -->
    <!-- Under the row that emails this scooter's charge recordings to Volt (the row reads "Email to Volt"). Volt uses the recordings to make its charging time estimates more accurate for this scooter's model. -->
    <string name="hub_charge_send_note" volt:screen="Charge history &amp; recordings" volt:purpose="caption" volt:safety="charge" volt:dnt="Volt">Sending your charge recordings to Volt helps improve charging time estimates for your scooter\'s model.</string>
    <!-- Toast when no email app on the phone can open the email with the charge recordings attached. -->
    <string name="hub_charge_send_no_email" volt:screen="Charge history &amp; recordings" volt:purpose="toast">No email app could open the charge recordings.</string>
    <!-- Toast when the owner taps "Email to Volt" while a charge is being recorded: the recordings can be sent only once the recording stops. -->
    <string name="hub_charge_send_busy" volt:screen="Charge history &amp; recordings" volt:purpose="toast" volt:safety="charge">Stop charge recording before sending the recordings</string>

    <!-- ===== Ride › Recording settings ===== -->
    <!-- Switch under Record rides automatically: lets that automatic start also happen while Volt is not on screen. Off by default. -->
    <string name="hub_recording_auto_background" volt:screen="Recording settings" volt:purpose="row" volt:safety="ride">Start recording in the background</string>
    <!-- Under that switch. Android does not let Volt turn on location from the background, so such a ride has no map. -->
    <string name="hub_recording_auto_background_note" volt:screen="Recording settings" volt:purpose="caption" volt:safety="ride" volt:dnt="Volt|GPS">A ride that starts while Volt is in the background has no GPS route.</string>

    <!-- ===== Battery & charging page: the summary card at the top ===== -->
    <!-- %1$s is the battery level as a percent ("72%"), %2$s the estimated range left with its unit ("14 mi"). -->
    <string name="hub_battery_level_range" volt:screen="Battery &amp; charging summary" volt:purpose="summary" volt:safety="charge">%1$s · about %2$s left</string>
    <!-- %1$s is the percent the charge stops at ("90%"). -->
    <string name="hub_battery_charging_to" volt:screen="Battery &amp; charging summary" volt:purpose="status" volt:safety="charge">Charging to %1$s</string>
    <string name="hub_battery_not_charging" volt:screen="Battery &amp; charging summary" volt:purpose="status" volt:safety="charge">Not charging</string>

    <!-- ===== Search (hub layout plan, PR 10): one page that finds pages, settings, live readings and rides ===== -->
    <!-- Title of the search page, opened from the magnifier in Home's header. Also the back link's target name. -->
    <string name="hub_page_search" volt:screen="Search page" volt:purpose="title">Search</string>
    <!-- Hint inside the empty search field. -->
    <string name="hub_search_hint" volt:screen="Search page" volt:purpose="hint">Search settings, readings and rides</string>
    <!-- Shown in place of results when nothing matches what was typed. -->
    <string name="hub_search_none" volt:screen="Search page" volt:purpose="status">No matches</string>
    <!-- Count of results under the field, also read out by screen readers as the results change. %1$d is the number of results. -->
    <plurals name="hub_search_count" volt:screen="Search page" volt:purpose="status">
        <item quantity="one">%1$d result</item>
        <item quantity="other">%1$d results</item>
    </plurals>
    <!-- Label above results that are pages (Battery & charging, Speed limits and so on). -->
    <string name="hub_search_group_pages" volt:screen="Search page" volt:purpose="section label">Pages</string>
    <!-- Label above results that are settings and controls. -->
    <string name="hub_search_group_settings" volt:screen="Search page" volt:purpose="section label">Settings</string>
    <!-- Label above results that are readings from the scooter right now (speed, battery temperature and so on). -->
    <string name="hub_search_group_readings" volt:screen="Search page" volt:purpose="section label">Live readings</string>
    <!-- Label above results that are saved rides. -->
    <string name="hub_search_group_rides" volt:screen="Search page" volt:purpose="section label">Rides</string>
    <!-- Small line under a result naming the subject it lives in. %1$s is that subject's name ("Battery & charging"). -->
    <string name="hub_search_in" volt:screen="Search page" volt:purpose="caption">In %1$s</string>

    <!-- ===== Widgets Home: the dock of subjects at the bottom ===== -->
    <!-- The dock's handle (swipe up or tap it), what TalkBack reads for the dock's "All" item, and the title of the sheet that lists every subject with its summary. -->
    <string name="hub_dock_all" volt:screen="Widgets Home dock" volt:purpose="handle, accessibility and sheet title">All subjects</string>

    <!-- ===== Wide Home (tablets and unfolded phones): the right pane ===== -->
    <!-- Link at the top of the right pane that goes back to the list of all subjects; also the label under the Widgets Home dock's last item, which opens that list on a phone. Keep it as short as the subjects' short names. -->
    <string name="hub_all" volt:screen="Wide Home, right pane; Widgets Home dock" volt:purpose="back link and dock label" volt:max="64dp@12sp">All</string>
    <!-- Title of the card listing the next maintenance checks. -->
    <string name="hub_service_card_title" volt:screen="Wide Home, Service card" volt:purpose="title">Next checks</string>
    <!-- Shown in that card when no maintenance reminder is set. -->
    <string name="hub_service_card_none" volt:screen="Wide Home, Service card" volt:purpose="status">No checks set</string>
</resources>
