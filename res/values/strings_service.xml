    <string name="service_test_title_no_resume" volt:screen="Scheduled charging test result" volt:purpose="title" volt:safety="charge">Charging didn\'t resume</string>
    <string name="service_test_title_interrupted" volt:screen="Scheduled charging test result" volt:purpose="title" volt:safety="charge">Scheduled charging test interrupted</string>
    <string name="service_test_title_cancelled" volt:screen="Scheduled charging test result" volt:purpose="title" volt:safety="charge">Test cancelled</string>
