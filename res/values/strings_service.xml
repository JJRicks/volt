        <item quantity="other">The scooter\'s clock and schedule work. Charging resumed %1$s seconds after the start.</item>
    </plurals>
    <!-- How far off the scooter's clock seems, used twice in each of the next two sentences: after
         "resumed" and after "ahead by" or "behind by". Choose a form that reads right in both places. -->
    <plurals name="service_test_about" volt:screen="Scheduled charging test result" volt:purpose="message part" volt:safety="charge">
        <item quantity="one">about %1$d minute</item>
        <item quantity="other">about %1$d minutes</item>
    </plurals>
    <!-- %1$s and %2$s are the same "about N minutes". %3$s is the set-clock sentence below, which brings its own leading space. -->
    <string name="service_test_early" volt:screen="Scheduled charging test result" volt:purpose="message" volt:safety="charge">Charging resumed %1$s before the start, so the scooter\'s clock may be ahead by %2$s.%3$s</string>
    <string name="service_test_late" volt:screen="Scheduled charging test result" volt:purpose="message" volt:safety="charge">Charging resumed %1$s after the start, so the scooter\'s clock may be behind by %2$s.%3$s</string>
    <!-- %1$s is the set-clock sentence below, which brings its own leading space. -->
    <string name="service_test_no_pause" volt:screen="Scheduled charging test result" volt:purpose="message" volt:safety="charge">The scooter didn\'t pause. Its clock may be ahead, or it ignored the schedule.%1$s</string>
    <!-- %1$s is the set-clock sentence below, which brings its own leading space. -->
    <string name="service_test_no_resume" volt:screen="Scheduled charging test result" volt:purpose="message" volt:safety="charge">Charging was still paused 5 minutes after the start. The scooter\'s clock may be behind by more than 5 minutes, or its schedule didn\'t release. If the charger was unplugged, test again.%1$s</string>
    <!-- Appended to the four results above, right after their last full stop: keep the leading space
