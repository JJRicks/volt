<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground service (batch B8): the connection notice and Volt's other notifications, their
  channels, the charge recording status (More › Developer), Charge done by and the Scheduled
  charging test, and the reasons the service gives when it refuses a change. The English must stay
  exactly what ScooterService said before the batch (G1, G2), including its known bugs.

  Where the source chose words with a condition ("Measured this charge. " or "Planned for a fresh
  charge. ", "second" or "seconds"), each choice is its own whole sentence here, so a language can
  order and inflect the whole of it. Only values (a time, a name, a number) are filled in.
-->
<resources xmlns:volt="https://volt.jjricks.com/ns/l10n"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ===== Why the service refuses a change (shown in a toast or a message) ===== -->

    <!-- Choosing another scooter or app data maintenance waits for a backup or restore. -->
    <string name="service_wait_backup" volt:screen="My scooters, backup" volt:purpose="reason">Wait for backup or restore to finish</string>
    <!-- A ride or charge recording is running. -->
    <string name="service_stop_recording_first" volt:screen="My scooters, backup" volt:purpose="reason">Stop the current recording first</string>
    <!-- The last ride's phone sensors are still being saved. -->
    <string name="service_wait_ride_saving" volt:screen="My scooters" volt:purpose="reason">Wait for the ride to finish saving</string>
    <!-- A setting is still being written to the scooter. -->
    <string name="service_wait_scooter_change" volt:screen="My scooters, backup" volt:purpose="reason">Wait for the current scooter change to finish</string>
    <!-- The Scheduled charging test is running. -->
    <string name="service_wait_schedule_test" volt:screen="My scooters, backup, simulation" volt:purpose="reason"
        volt:safety="charge">Wait for the schedule test to finish</string>
    <!-- A backup or restore was started twice. -->
    <string name="service_maintenance_in_progress" volt:screen="Backup" volt:purpose="reason">App data maintenance is already in progress</string>
    <!-- The phone sensors of a ride are still being saved. -->
    <string name="service_wait_phone_saving" volt:screen="Backup" volt:purpose="reason">Wait for the phone recording to finish saving</string>
    <!-- A finished ride is being copied to the rider's auto-save folder. -->
    <string name="service_wait_auto_save" volt:screen="Backup" volt:purpose="reason">Wait for the ride copy to finish saving</string>
    <!-- A charge recording export is being prepared. -->
    <string name="service_finish_charge_export" volt:screen="Backup" volt:purpose="reason">Finish the current charge export first</string>
    <!-- Volt is still writing a charging schedule to the scooter. -->
    <string name="service_wait_charging_schedule" volt:screen="Backup" volt:purpose="reason"
        volt:safety="charge">Wait for Volt to finish setting the charging schedule</string>
    <!-- Charge done by is measuring the charge for up to ten minutes. "Charge done by" is the feature's name. -->
    <string name="service_wait_measuring" volt:screen="Backup, simulation, schedule test" volt:purpose="reason"
        volt:safety="charge">Wait for Charge done by to finish measuring</string>
    <!-- Saved readings are being deleted. -->
    <string name="service_wait_history_cleanup" volt:screen="Backup" volt:purpose="reason">Wait for history cleanup to finish</string>
    <!-- Owner setup through Shizuku changed NAVEE's logging and has not put it back yet. -->
    <string name="service_finish_owner_setup" volt:screen="Backup" volt:purpose="reason" volt:safety="owner-key"
        volt:dnt="NAVEE">Finish owner setup and restore NAVEE logging first</string>
    <!-- A file is still being exported. -->
    <string name="service_finish_export" volt:screen="Backup" volt:purpose="reason">Finish the current export first</string>
    <!-- An owner setup file is still being imported. -->
    <string name="service_finish_owner_import" volt:screen="Backup" volt:purpose="reason" volt:safety="owner-key">Finish importing owner setup first</string>
    <!-- Backup or restore could not stop the service's work in time; Volt restarts afterwards. -->
    <string name="service_maintenance_failed" volt:screen="Backup" volt:purpose="error" volt:dnt="Volt">Couldn\'t prepare app data. Reopen Volt.</string>
    <!-- Sample data cannot start while a ride or charge is recorded. -->
    <string name="service_simulation_finish_recording" volt:screen="More › Developer" volt:purpose="toast">Finish the current recording before simulating</string>

    <!-- ===== Charge recording (More › Developer › Charge recording) ===== -->

    <!-- Status line before any charge was recorded since Volt started. -->
    <string name="service_charge_none" volt:screen="More › Developer › Charge recording" volt:purpose="status">No charge recording yet</string>
    <string name="service_charge_storage_unavailable" volt:screen="More › Developer › Charge recording" volt:purpose="status">Charge recording storage is unavailable</string>
    <string name="service_charge_enable_developer" volt:screen="More › Developer › Charge recording" volt:purpose="reason">Enable developer options first</string>
    <string name="service_charge_simulation" volt:screen="More › Developer › Charge recording" volt:purpose="reason">Turn off simulation to record a real charge</string>
    <string name="service_charge_finish_ride" volt:screen="More › Developer › Charge recording" volt:purpose="reason">Finish the ride recording first</string>
    <string name="service_charge_preparing_export" volt:screen="More › Developer › Charge recording" volt:purpose="status">Preparing charge export</string>
    <string name="service_charge_loading" volt:screen="More › Developer › Charge recording" volt:purpose="status">Loading saved charge recordings</string>
    <string name="service_charge_connect_scooter" volt:screen="More › Developer › Charge recording" volt:purpose="reason">Connect your scooter first</string>
    <string name="service_charge_wait_readings" volt:screen="More › Developer › Charge recording" volt:purpose="reason">Wait for fresh charging readings</string>
    <string name="service_charge_battery_full" volt:screen="More › Developer › Charge recording" volt:purpose="reason">Battery is already at 100%%</string>
    <!-- The recording's notification carries its Stop button, so notifications must be allowed. -->
    <string name="service_charge_allow_notifications" volt:screen="More › Developer › Charge recording" volt:purpose="reason">Allow app notifications so the Stop action stays available</string>
    <string name="service_charge_choose_charger" volt:screen="More › Developer › Charge recording" volt:purpose="status">Choose the attached charger</string>
    <string name="service_charge_started" volt:screen="More › Developer › Charge recording" volt:purpose="status">Charge recording started</string>
    <string name="service_charge_start_failed" volt:screen="More › Developer › Charge recording" volt:purpose="status">Could not start charge recording</string>
    <!-- The scooter's link dropped during a charge recording; %1$s is the number of seconds Volt keeps trying. "s" is the seconds symbol. -->
    <string name="service_charge_reconnecting" volt:screen="More › Developer › Charge recording; connection notice" volt:purpose="status">Reconnecting · %1$ss</string>
    <!-- The running recording, by charger: the stock charger cut out (it often does when hot) and Volt waits for it. -->
    <string name="service_charge_stock_charger_paused" volt:screen="More › Developer › Charge recording; connection notice" volt:purpose="status">Stock charger · charger stopped · waiting for it to resume</string>
    <!-- Volt's own charging schedule holds the current off until its start. -->
    <string name="service_charge_stock_schedule_paused" volt:screen="More › Developer › Charge recording; connection notice" volt:purpose="status">Stock charger · paused until the scheduled start</string>
    <!-- Unused since the fixed-count plurals: kept for B8's ledger row, no need to translate. -->
    <string name="service_charge_stock_samples" volt:screen="More › Developer › Charge recording; connection notice" volt:purpose="status">Stock charger · %1$s local samples</string>
    <!-- %1$s is the number of readings saved so far, and picks the plural form. -->
    <plurals name="service_charge_stock_samples_count" volt:screen="More › Developer › Charge recording; connection notice" volt:purpose="status">
        <item quantity="one">Stock charger · %1$s local sample</item>
        <item quantity="other">Stock charger · %1$s local samples</item>
    </plurals>
    <string name="service_charge_fast_charger_paused" volt:screen="More › Developer › Charge recording; connection notice" volt:purpose="status">High-speed charger · charger stopped · waiting for it to resume</string>
    <string name="service_charge_fast_schedule_paused" volt:screen="More › Developer › Charge recording; connection notice" volt:purpose="status">High-speed charger · paused until the scheduled start</string>
    <!-- Unused since the fixed-count plurals: kept for B8's ledger row, no need to translate. -->
    <string name="service_charge_fast_samples" volt:screen="More › Developer › Charge recording; connection notice" volt:purpose="status">High-speed charger · %1$s local samples</string>
    <!-- %1$s is the number of readings saved so far, and picks the plural form. -->
    <plurals name="service_charge_fast_samples_count" volt:screen="More › Developer › Charge recording; connection notice" volt:purpose="status">
        <item quantity="one">High-speed charger · %1$s local sample</item>
        <item quantity="other">High-speed charger · %1$s local samples</item>
    </plurals>
    <!-- Unused since the fixed-count plurals: kept for B8's ledger row, no need to translate. -->
    <string name="service_charge_learning_unknown" volt:screen="More › Developer › Charge recording" volt:purpose="summary">Not applied until the charger is known · %1$s recordings stored</string>
    <!-- Which charges the estimates learn from. %1$s is the number of recordings stored for every scooter and charger, and picks the plural form. -->
    <plurals name="service_charge_learning_unknown_count" volt:screen="More › Developer › Charge recording" volt:purpose="summary">
        <item quantity="one">Not applied until the charger is known · %1$s recording stored</item>
        <item quantity="other">Not applied until the charger is known · %1$s recordings stored</item>
    </plurals>
    <!-- Unused since the fixed-count plurals: kept for B8's ledger row, no need to translate. -->
    <string name="service_charge_learning_fast_one" volt:screen="More › Developer › Charge recording" volt:purpose="summary">%1$s qualified high-speed charge · %2$s recordings stored</string>
    <!-- How many charge recordings are stored (%2$s of service_charge_learning_fast_count and _stock_count): %1$s is the number, and picks the plural form. -->
    <plurals name="service_charge_recordings_stored" volt:screen="More › Developer › Charge recording" volt:purpose="summary">
        <item quantity="one">%1$s recording stored</item>
        <item quantity="other">%1$s recordings stored</item>
    </plurals>
    <!-- Unused since the fixed-count plurals: kept for B8's ledger row, no need to translate. -->
    <string name="service_charge_learning_fast_other" volt:screen="More › Developer › Charge recording" volt:purpose="summary">%1$s qualified high-speed charges · %2$s recordings stored</string>
    <!-- %1$s is how many recorded charges with the high-speed charger qualify, and picks the plural form; %2$s is service_charge_recordings_stored, which follows its own number. -->
    <plurals name="service_charge_learning_fast_count" volt:screen="More › Developer › Charge recording" volt:purpose="summary">
        <item quantity="one">%1$s qualified high-speed charge · %2$s</item>
        <item quantity="other">%1$s qualified high-speed charges · %2$s</item>
    </plurals>
    <!-- Unused since the fixed-count plurals: kept for B8's ledger row, no need to translate. -->
    <string name="service_charge_learning_stock_one" volt:screen="More › Developer › Charge recording" volt:purpose="summary">%1$s qualified stock charge · %2$s recordings stored</string>
    <!-- Unused since the fixed-count plurals: kept for B8's ledger row, no need to translate. -->
    <string name="service_charge_learning_stock_other" volt:screen="More › Developer › Charge recording" volt:purpose="summary">%1$s qualified stock charges · %2$s recordings stored</string>
    <!-- %1$s is how many recorded charges with the stock charger qualify, and picks the plural form; %2$s is service_charge_recordings_stored, which follows its own number. -->
    <plurals name="service_charge_learning_stock_count" volt:screen="More › Developer › Charge recording" volt:purpose="summary">
        <item quantity="one">%1$s qualified stock charge · %2$s</item>
        <item quantity="other">%1$s qualified stock charges · %2$s</item>
    </plurals>
    <string name="service_charge_cleared" volt:screen="More › Developer › Charge recording" volt:purpose="status">Charge recordings cleared</string>
    <string name="service_charge_clear_failed" volt:screen="More › Developer › Charge recording" volt:purpose="error">Charge recordings could not be cleared</string>
    <string name="service_charge_export_empty" volt:screen="More › Developer › Charge recording" volt:purpose="error">No saved charge recordings for this scooter</string>
    <string name="service_charge_export_failed" volt:screen="More › Developer › Charge recording" volt:purpose="error">Charge recordings could not be exported</string>
    <string name="service_charge_limit_reached" volt:screen="More › Developer › Charge recording" volt:purpose="status">Charge recording reached its storage or time limit</string>
    <string name="service_charge_saved_full" volt:screen="More › Developer › Charge recording" volt:purpose="status">Charge recording saved · battery reached 100%%</string>
    <string name="service_charge_saved" volt:screen="More › Developer › Charge recording" volt:purpose="status">Charge recording saved</string>
    <!-- A recording Volt started by itself ended too short to keep (under 10 minutes or under 5 battery percentage points), so it was deleted. -->
    <string name="service_charge_not_kept" volt:screen="More › Developer › Charge recording" volt:purpose="status">Charge recording not kept · under 10 min or 5%%</string>
    <!-- Record charges automatically could not start a recording for this charge: Volt keeps at most 20 charge recordings in all, shared by every scooter, and all 20 are ones the owner started; Volt never deletes those to make room. Clearing any scooter's charge recordings that holds some makes room. -->
    <string name="service_charge_auto_no_room" volt:screen="More › Developer › Charge recording" volt:purpose="status">Not recording this charge: the 20 saved charge recordings, shared by all your scooters, are all ones you started. Clear a scooter\'s charge recordings to make room.</string>
    <!-- %1$s is a recording's status or summary, which starts with its charger ("Stock charger · 12 local samples", "Stock charger · 52% → 80%"): that charger is Volt's guess for a recording that started by itself, neither chosen nor detected. -->
    <string name="service_charge_charger_guessed" volt:screen="More › Developer › Charge recording; connection notice; More › Charge recordings" volt:purpose="status">%1$s · charger guessed</string>
    <string name="service_charge_storage_error" volt:screen="More › Developer › Charge recording" volt:purpose="status">Charge recording stopped after a storage error</string>
    <!-- %1$s says why, one of the service_charge_stop_* labels below (lower case, as English shows them). -->
    <string name="service_charge_stopped_reason" volt:screen="More › Developer › Charge recording" volt:purpose="status">Charge recording stopped · %1$s</string>
    <!-- Why a charge recording stopped, after "Charge recording stopped · ". Lower case in English. -->
    <string name="service_charge_stop_charging_ended" volt:screen="More › Developer › Charge recording" volt:purpose="status part">charging ended</string>
    <string name="service_charge_stop_disconnected" volt:screen="More › Developer › Charge recording" volt:purpose="status part">disconnected</string>
    <!-- Another scooter was chosen, or the connected scooter is a different one. -->
    <string name="service_charge_stop_profile_changed" volt:screen="More › Developer › Charge recording" volt:purpose="status part">profile changed</string>
    <string name="service_charge_stop_readings_stopped" volt:screen="More › Developer › Charge recording" volt:purpose="status part">readings stopped</string>
    <!-- The recording reached its size or time limit. -->
    <string name="service_charge_stop_limit" volt:screen="More › Developer › Charge recording" volt:purpose="status part">limit</string>
    <!-- Android ended Volt while it recorded. -->
    <string name="service_charge_stop_process_ended" volt:screen="More › Developer › Charge recording" volt:purpose="status part">process ended</string>
    <string name="service_charge_stop_interrupted" volt:screen="More › Developer › Charge recording" volt:purpose="status part">interrupted</string>
    <!-- Volt could not reconnect to the scooter in time. -->
    <string name="service_charge_stop_recovery_timeout" volt:screen="More › Developer › Charge recording" volt:purpose="status part">recovery timeout</string>
    <string name="service_charge_stop_connection_failed" volt:screen="More › Developer › Charge recording" volt:purpose="status part">connection failed</string>
    <!-- The phone's Bluetooth was turned off. English shows it in lower case. -->
    <string name="service_charge_stop_bluetooth_off" volt:screen="More › Developer › Charge recording" volt:purpose="status part">bluetooth off</string>
    <!-- Volt lost its Bluetooth permission. -->
    <string name="service_charge_stop_permission_lost" volt:screen="More › Developer › Charge recording" volt:purpose="status part">permission lost</string>
    <!-- The scooter answered with another identity than the one recorded. -->
    <string name="service_charge_stop_identity_changed" volt:screen="More › Developer › Charge recording" volt:purpose="status part">different scooter</string>
    <string name="service_charge_not_finalized" volt:screen="More › Developer › Charge recording" volt:purpose="error">Recording stopped; charge file could not be finalized</string>
    <!-- Charge done by waits until Volt knows which charger is attached. -->
    <string name="service_charger_detection" volt:screen="Scooter › Battery › Charge done by" volt:purpose="reason"
        volt:safety="charge">Wait for charger detection or select a charger</string>

    <!-- ===== A scheduled start that didn't start charging (dialog in Volt, notification outside) ===== -->

    <string name="service_missed_title_done_by" volt:screen="Missed start dialog and notification" volt:purpose="title"
        volt:safety="charge">Charge done by didn\'t start charging</string>
    <string name="service_missed_title_schedule" volt:screen="Missed start dialog and notification" volt:purpose="title"
        volt:safety="charge">Scheduled charging didn\'t start</string>
    <!-- Charge done by set the start. %1$s is the planned start time, %2$s the battery percent now,
         %3$s the percent when it was armed. Shown in Volt's dialog, which offers to turn the schedule off. -->
    <string name="service_missed_done_by_dialog" volt:screen="Missed start dialog" volt:purpose="message" volt:safety="charge"
        volt:dnt="Volt">Charging was set to start at %1$s, and the battery is still at %2$s%% (%3$s%% when you set it). Check that the charger is plugged in and its light turns red at the start time. Volt can turn the schedule off so charging starts now.</string>
    <!-- The same in a notification, outside Volt. -->
    <string name="service_missed_done_by_notice" volt:screen="Missed start notification" volt:purpose="message" volt:safety="charge"
        volt:dnt="Volt">Charging was set to start at %1$s, and the battery is still at %2$s%% (%3$s%% when you set it). Check that the charger is plugged in and its light turns red at the start time. Open Volt to turn the schedule off so charging starts now.</string>
    <!-- Charge done by set the start, during an interrupted Scheduled charging test (%3$s: the percent at the test). -->
    <string name="service_missed_done_by_test_dialog" volt:screen="Missed start dialog" volt:purpose="message" volt:safety="charge"
        volt:dnt="Volt">Charging was set to start at %1$s, and the battery is still at %2$s%% (%3$s%% at the test). Check that the charger is plugged in and its light turns red at the start time. Volt can turn the schedule off so charging starts now.</string>
    <string name="service_missed_done_by_test_notice" volt:screen="Missed start notification" volt:purpose="message" volt:safety="charge"
        volt:dnt="Volt">Charging was set to start at %1$s, and the battery is still at %2$s%% (%3$s%% at the test). Check that the charger is plugged in and its light turns red at the start time. Open Volt to turn the schedule off so charging starts now.</string>
    <!-- An interrupted Scheduled charging test left the charge paused until %1$s. -->
    <string name="service_missed_test_dialog" volt:screen="Missed start dialog" volt:purpose="message" volt:safety="charge"
        volt:dnt="Volt">The schedule test set it to resume at %1$s, and the battery is still at %2$s%% (%3$s%% at the test). Check that the charger is plugged in and its light turns red at the start time. Volt can turn the schedule off so charging starts now.</string>
    <string name="service_missed_test_notice" volt:screen="Missed start notification" volt:purpose="message" volt:safety="charge"
        volt:dnt="Volt">The schedule test set it to resume at %1$s, and the battery is still at %2$s%% (%3$s%% at the test). Check that the charger is plugged in and its light turns red at the start time. Open Volt to turn the schedule off so charging starts now.</string>
    <!-- The owner set Scheduled charging to start at %1$s. -->
    <string name="service_missed_set_dialog" volt:screen="Missed start dialog" volt:purpose="message" volt:safety="charge"
        volt:dnt="Volt">It was set for %1$s, and the battery is still at %2$s%% (%3$s%% when you set it). Check that the charger is plugged in and its light turns red at the start time. Volt can turn the schedule off so charging starts now.</string>
    <string name="service_missed_set_notice" volt:screen="Missed start notification" volt:purpose="message" volt:safety="charge"
        volt:dnt="Volt">It was set for %1$s, and the battery is still at %2$s%% (%3$s%% when you set it). Check that the charger is plugged in and its light turns red at the start time. Open Volt to turn the schedule off so charging starts now.</string>

    <!-- ===== Charge done by's measuring window ===== -->

    <!-- After measuring, Charge done by armed with the measured charge. %1$s is when charging resumes, %2$s the finish time. -->
    <string name="service_measure_measured" volt:screen="Charge done by toast and notification" volt:purpose="message"
        volt:safety="charge">Measured this charge. Charging resumes at %1$s to finish by %2$s.</string>
    <!-- Volt could not tell how far the charge got, so it planned for a fresh one. -->
    <string name="service_measure_planned" volt:screen="Charge done by toast and notification" volt:purpose="message"
        volt:safety="charge">Planned for a fresh charge. Charging resumes at %1$s to finish by %2$s.</string>
    <string name="service_measure_off" volt:screen="Charge done by toast and notification" volt:purpose="message"
        volt:safety="charge">Charge done by is off.</string>
    <!-- %1$s is why the schedule was not set, a sentence without its final full stop. -->
    <string name="service_measure_result" volt:screen="Charge done by toast and notification" volt:purpose="message"
        volt:safety="charge">%1$s.</string>
    <!-- %1$s is why measuring ended without a schedule, a sentence without its final full stop. -->
    <string name="service_measure_not_set" volt:screen="Charge done by toast and notification" volt:purpose="message"
        volt:safety="charge">%1$s. Charge done by is off.</string>
    <string name="service_measure_bluetooth_removed" volt:screen="Charge done by toast and notification" volt:purpose="reason"
        volt:safety="charge">Bluetooth permission was removed while measuring</string>
    <string name="service_measure_closed" volt:screen="Charge done by notification" volt:purpose="message" volt:safety="charge"
        volt:dnt="Volt">Volt closed while measuring. Charge done by is off.</string>
    <!-- Toast in Volt: %1$s is the message above (measured, planned or why not). -->
    <string name="service_done_toast_set" volt:screen="Charge done by toast" volt:purpose="toast" volt:safety="charge">Charge done by is set. %1$s</string>
    <string name="service_done_toast_not_set" volt:screen="Charge done by toast" volt:purpose="toast" volt:safety="charge">Charge done by wasn\'t set. %1$s</string>
    <!-- %1$s is the clock time charging will start on the scooter. Shown only after the scooter has confirmed that start; a text toast shows at most two lines. -->
    <string name="service_done_start_sent" volt:screen="Charge done by toast and notification" volt:purpose="message"
        volt:max="260dp@14sp*2" volt:safety="charge">%1$s charge start sent to scooter. Safe to disconnect.</string>
    <!-- %1$s is a complete sentence saying when charging resumes and when it finishes. -->
    <string name="service_done_safe_to_disconnect" volt:screen="Charge done by notification" volt:purpose="message"
        volt:safety="charge">%1$s Safe to disconnect.</string>
    <string name="service_done_title_set" volt:screen="Charge done by notification" volt:purpose="title" volt:safety="charge">Charge done by is set</string>
    <string name="service_done_title_not_set" volt:screen="Charge done by notification" volt:purpose="title" volt:safety="charge">Charge done by wasn\'t set</string>

    <!-- ===== Scheduled charging test (Scooter › Battery) ===== -->

    <string name="service_test_reopen" volt:screen="Scheduled charging test" volt:purpose="reason" volt:dnt="Volt">Reopen Volt</string>
    <string name="service_test_cancelled_toast" volt:screen="Scheduled charging test" volt:purpose="toast" volt:safety="charge">Test cancelled. Scheduled charging is off.</string>
