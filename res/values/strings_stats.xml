    <string name="stats_state_expanded" volt:screen="Live Stats › Readings and Charts" volt:purpose="accessibility state">Expanded</string>
    <string name="stats_state_collapsed" volt:screen="Live Stats › Readings and Charts" volt:purpose="accessibility state">Collapsed</string>
