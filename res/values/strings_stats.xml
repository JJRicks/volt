    <string name="stats_charge_full_observed" formatted="false" volt:screen="More › Charge recordings" volt:purpose="status" volt:safety="charge">100% observed</string>
    <!-- Follows the recording's status: %1$s is how long a Volt charging schedule paused charging ("1 h 5 min"). -->
    <string name="stats_charge_paused_schedule" volt:screen="More › Charge recordings" volt:purpose="status" volt:safety="charge">" · paused %1$s for the schedule"</string>
    <!-- Follows the recording's status: %1$d is how many times the charger stopped charging, %2$s for how long in all ("12 min").
         English "once" means exactly 1 stop. In a language whose "one" category also covers other
         counts (Russian, Ukrainian, Belarusian, Lithuanian, Latvian, Croatian, Serbian and Bosnian
         "one" covers 21, 31, 41...; Brazilian Portuguese and French "one" covers 0), the "one" item
         must keep %1$d and say the count ("%1$d time"), never a word for once. -->
    <plurals name="stats_charge_charger_stopped" volt:screen="More › Charge recordings" volt:purpose="status" volt:safety="charge">
        <item quantity="one">" · charger stopped once (%2$s)"</item>
        <item quantity="other">" · charger stopped %1$d times (%2$s)"</item>
