    <string name="stats_drive_mode_description" volt:screen="Live Stats rows" volt:purpose="accessibility description">Drive mode, %1$s, %2$s</string>
    <!-- Small tag before a value the scooter reports undecoded. Keep it short. -->
    <string name="stats_raw_chip" volt:screen="Live Stats rows" volt:purpose="tag" volt:max="40dp@10sp">RAW</string>
    <!-- Spoken undecoded value: %1$s is the value. -->
    <string name="stats_raw_said" volt:screen="Live Stats rows" volt:purpose="accessibility description">raw %1$s</string>
    <!-- A distance or speed in both unit systems: %1$s as the scooter reports it, %2$s converted. -->
    <string name="stats_value_dual" volt:screen="Live Stats rows" volt:purpose="value">"%1$s  /  %2$s"</string>
