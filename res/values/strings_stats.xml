    <string name="stats_favourite_remove" volt:screen="Live Stats › Readings" volt:purpose="accessibility description">Remove %1$s from favorites</string>
    <string name="stats_favourite_on" volt:screen="Live Stats › Readings and Charts" volt:purpose="accessibility state">Favorite</string>
    <string name="stats_favourite_off" volt:screen="Live Stats › Readings and Charts" volt:purpose="accessibility state">Not a favorite</string>
    <!-- Under a reading's name when the scooter has not supplied a value. -->
    <string name="stats_age_not_supplied" volt:screen="Live Stats rows" volt:purpose="status">Not supplied</string>
    <!-- Said for a reading the scooter is reporting now. -->
    <string name="stats_age_live" volt:screen="Live Stats rows" volt:purpose="status">Live</string>
    <!-- A saved reading's age when its time is unknown. -->
    <string name="stats_last_seen" volt:screen="Live Stats rows" volt:purpose="status">Last seen</string>
