<?xml version="1.0" encoding="utf-8"?>
<!--
  Live Stats and charge history (batch B16): the Live Stats sections, Overview, Readings, the chart
  browser and Diagnostics, and the charge recordings pages. The English must stay exactly what the
  source said before the batch (G1, G2).

  Where the source added optional words to a sentence, each combination is its own whole template, so
  a language can order, join and inflect the whole phrase; only values (a reading's name, a value, a
  time) are filled in. Reading names, group names and unit symbols come from the readings and units
  catalogs. Section, group and chart-window choices are stored by their English ids, never by these
  texts.
-->
<resources xmlns:volt="https://volt.jjricks.com/ns/l10n"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Sections -->
    <!-- Spoken name of the Live Stats section tabs. -->
    <string name="stats_sections_description" volt:screen="Live Stats" volt:purpose="accessibility description">Live Stats section</string>
    <!-- The Live Stats section tabs, side by side in one narrow segmented row (four on a phone, three on a wide screen, where Readings stays open beside them). The row scrolls rather than break a word or shrink the text, so keep each tab one short word. The choice is stored by its English id, never by this text. -->
    <string name="stats_tab_overview" volt:screen="Live Stats, section tabs" volt:purpose="tab" volt:max="72dp@13sp">Overview</string>
    <!-- A Live Stats section tab: every reading the scooter reports, with search. -->
    <string name="stats_tab_readings" volt:screen="Live Stats, section tabs" volt:purpose="tab" volt:max="72dp@13sp">Readings</string>
    <!-- A Live Stats section tab: the chart browser. -->
    <string name="stats_tab_charts" volt:screen="Live Stats, section tabs" volt:purpose="tab" volt:max="72dp@13sp">Charts</string>
    <!-- A Live Stats section tab: device details, connection events and raw payloads. -->
    <string name="stats_tab_diagnostics" volt:screen="Live Stats, section tabs" volt:purpose="tab" volt:max="72dp@13sp">Diagnostics</string>

    <!-- Overview -->
    <string name="stats_overview_waiting" volt:screen="Live Stats › Overview" volt:purpose="heading">Waiting for readings</string>
    <!-- Under the battery ring when the scooter has not reported its battery level. -->
    <string name="stats_battery_no_reading" volt:screen="Live Stats › Overview battery ring" volt:purpose="caption" volt:max="96dp@11sp">No reading</string>
    <!-- Under the battery ring when the level shown is the last one saved. -->
    <string name="stats_battery_last_seen" volt:screen="Live Stats › Overview battery ring" volt:purpose="caption" volt:max="96dp@11sp">Last seen</string>
    <string name="stats_range_not_reported" volt:screen="Live Stats › Overview" volt:purpose="heading">Range not reported</string>
    <!-- %1$s is the range as the scooter reported it, when it is not a number. -->
    <string name="stats_range_value" volt:screen="Live Stats › Overview" volt:purpose="heading">Range %1$s</string>
    <!-- Range in both units: %1$s miles, %2$s the mile symbol, %3$s kilometres, %4$s the km symbol ("7 mi / 12 km"). -->
    <string name="stats_range_dual" volt:screen="Live Stats › Overview" volt:purpose="number format">%1$s %2$s / %3$s %4$s</string>
    <!-- %1$s is the remaining range with its unit ("12 km", "7 mi / 12 km"). -->
    <string name="stats_range_left" volt:screen="Live Stats › Overview" volt:purpose="heading">≈ %1$s left</string>
    <!-- Label before the pack temperature on Overview ("Pack 24 °C"); the temperature follows it. -->
    <string name="stats_pack" volt:screen="Live Stats › Overview" volt:purpose="label">"Pack "</string>
    <!-- Label before the battery health percentage on Overview ("Health 92 %"); the percentage and a small "est." tag follow it. -->
    <string name="stats_health" volt:screen="Live Stats › Overview" volt:purpose="label">"Health "</string>
    <!-- The same label after the pack temperature ("Pack 24 °C · Health 92 %"); the percentage and a small "est." tag follow it. -->
    <string name="stats_health_after" volt:screen="Live Stats › Overview" volt:purpose="label">" · Health "</string>
    <!-- Small tag after the health figure: the controller's health is an estimate. Keep it short. -->
    <string name="stats_health_chip" volt:screen="Live Stats › Overview" volt:purpose="tag" volt:max="40dp@9sp">est.</string>
    <!-- What TalkBack says for the "est." tag after the health figure ("Health 92 % estimated"); it
         replaces the tag and the space before it, so it starts with a space. -->
    <string name="stats_health_chip_said" volt:screen="Live Stats › Overview" volt:purpose="accessibility description">" estimated"</string>
    <string name="stats_favourites_title" volt:screen="Live Stats › Overview" volt:purpose="heading">Favorites</string>
