    <string name="stats_detail_raw_seen_when" volt:screen="Live Stats › reading details" volt:purpose="message">%1$s (raw) · Last seen %2$s</string>
    <string name="stats_detail_live" volt:screen="Live Stats › reading details" volt:purpose="message">%1$s · Live</string>
    <string name="stats_detail_live_when" volt:screen="Live Stats › reading details" volt:purpose="message">%1$s · Live %2$s</string>
    <string name="stats_detail_seen" volt:screen="Live Stats › reading details" volt:purpose="message">%1$s · Last seen</string>
    <string name="stats_detail_seen_when" volt:screen="Live Stats › reading details" volt:purpose="message">%1$s · Last seen %2$s</string>
