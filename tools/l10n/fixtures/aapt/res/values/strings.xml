<?xml version="1.0" encoding="utf-8"?>
<!--
  Round-trip fixture: what aapt 36.1.0 stores for each spelling. Names starting with ok_ are spellings
  gen_catalog accepts and that compile to exactly the text the generator expects. Names starting
  with bad_ are spellings aapt silently rewrites; gen_catalog refuses them and roundtrip.py must
  flag them. Regenerate the captured outputs with capture.sh after editing this file.
-->
<resources xmlns:volt="https://volt.jjricks.com/ns/l10n" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
