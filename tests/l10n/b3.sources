tests/l10n/characterization/ReadingsTextTest.java
# B3's own suite: full names and groups equal Telemetry's English, the stored unit suffixes, chart legends,
# Live Stats quantities in a comma locale, and every display text from the catalog under a key-echo source.
tests/l10n/ReadingsCatalogTest.java
