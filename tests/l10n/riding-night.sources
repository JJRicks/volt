# Riding mode's night vision (ride-display plan, PR 3). tests/run.sh compiles every path listed in tests/l10n/*.sources
# and runs each tests/l10n/**Test.java from the repository root. NightScheduleTest covers the sun times (SunTimes),
# the schedule and the moon override (NightSchedule), the time-zone table and the rounded last-ride fix
# (NightPlaces, res/raw/tz_coords.txt) and night vision's dim range and colour filter (NightVision).
src/com/jjricks/volt/BrightnessCurve.java
src/com/jjricks/volt/SunTimes.java
src/com/jjricks/volt/NightSchedule.java
src/com/jjricks/volt/NightPlaces.java
src/com/jjricks/volt/NightVision.java
tests/l10n/NightScheduleTest.java
