# Automatic ride copies (RideAutoExport, docs/recording-reference.md). tests/run.sh compiles every path listed
# in tests/l10n/*.sources and runs each tests/l10n/**Test.java from the repository root.
# The pure part: the name, the waiting list, the switch and its retired Route CSV key, failure ids, the row state
# and the file's bytes against the sheet's Everything export, also under a throwing text source;
# RideAutoExportNoticeTest, when a failure posts its notice. RideStore, PhoneRideStore and BackupRegistry are in
# tests/run.sh's own list.
src/com/jjricks/volt/RideAutoExport.java
src/com/jjricks/volt/RideExportFiles.java
src/com/jjricks/volt/RideExportEverything.java
tests/l10n/RideAutoExportTest.java
tests/l10n/RideAutoExportNoticeTest.java
