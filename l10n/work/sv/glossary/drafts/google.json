 "notes": {
  "charge-done-by": "Klar senast as label/tile; per section 7, sentences write funktionen Klar senast or put Klar senast in quotes.",
  "energy-recovery": "Energiåtervinning is used; återvinning alone means recycling.",
  "maximum-speed": "Maxhastighet denotes the configurable limit; toppfart denotes the measured speed.",
  "miles": "Bare mil in Swedish means 10 km, so the English unit is explicitly engelska mil or symbol mi per style guide section 4.",
  "not-reported": "Fixed words table mandates 'Ingen uppgift', never 'ej rapporterat'.",
  "odometer-short": "Totalt is preferred per style guide section 5; Vägm. is the literal abbreviation ladder rung.",
  "owner-setup-file-scooter-access": "Uses bara per style guide section 7 (only -> bara, not endast) and ägarfil for onboarding/backup tiles.",
  "scooter": "Elsparkcykel is standard; elspark is reserved for width-limited rungs.",
  "top-speed": "Toppfart is strictly the measured peak speed.",
  "unlocked": "Olåst is banned to prevent visual confusion with låst; upplåst is used everywhere."
 },
