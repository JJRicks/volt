# Generated by tools/l10n/pack.py; rebuilt on every run (l10n/README.md, Running a language).
/packs/
# Prompts and raw agent replies are regenerated or folded into drafts/ and backtranslation.jsonl.
/work/*/*/prompts/
/work/*/*/replies/
# The safety audit keeps its record, not its prompts, replies or sidecars.
/work/*/*/audit/*
!/work/*/*/audit/compare.tsv
!/work/*/*/audit/verdicts.tsv
